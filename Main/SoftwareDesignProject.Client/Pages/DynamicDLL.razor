@page "/dynamicDLL/{DLLName}"
@inject NavigationManager NavigationManager
@inject IServiceProvider ServiceProvider

@_content

@code {
    [Parameter]
    public string DLLName { get; set; }
    private RenderFragment? _content;
    private string _currentDllName = "";

    private IDynamicPageLoader? PageLoader { get; set; } = null;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (OperatingSystem.IsBrowser())
        {
            PageLoader = ServiceProvider.GetService<IDynamicPageLoader>();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_currentDllName == DLLName)
            return;
        
        if (PageLoader == null)
            return;
        
        try
        {
            var dll = await PageLoader.LoadDynamicAssembly($"/api/plugins/{DLLName}.dll");
            var componentType = dll?.EntryPoint;
            if (componentType != null)
            {
                _currentDllName = DLLName;
                ShowComponent(componentType);
            }
        }
        catch (HttpRequestException e)
        {
            // Console.WriteLine(e.Message);
            NavigationManager.NavigateTo("/404");
        }
    }
    
    private void ShowComponent(Type componentType)
    {
        _content = builder =>
        {
            builder.OpenComponent<DynamicComponent>(0);
            builder.AddAttribute(0, "Type", componentType);
            builder.CloseComponent();
        };
        StateHasChanged();
    }
}