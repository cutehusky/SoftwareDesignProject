@page "/dynamicDLL/{name}"
@inject IDynamicPageLoader PageLoader
@inject NavigationManager NavigationManager
@_content
@if (_errorContent.Length > 0)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled"> @_errorContent </MudAlert>
}

@code {
    [Parameter]
    public string name { get; set; }
    private RenderFragment? _content;
    private string _errorContent = "";
    
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var dll = await PageLoader.LoadDynamicAssembly($"/api/plugins/{name}.dll");
            var componentType = dll?.GetComponentType("RazorClassLibrary_test.Component1");
            if (componentType != null)
                ShowComponent(componentType);
        }
        catch (HttpRequestException e)
        {
            // Console.WriteLine(e.Message);
            ShowError("Error: " + e.Message);
            NavigationManager.NavigateTo("/404");
        } 
    }

    private void ShowError(string error)
    {
        _errorContent = error;
    }

    private Dictionary<string, object> parameters = new()
    {
        { "endpoint", "/api/test" }
    };
    
    private void ShowComponent(Type componentType)
    {
        _content = builder =>
        {
            builder.OpenComponent<DynamicComponent>(0);
            builder.AddAttribute(0, "Type", componentType);
            builder.AddAttribute(1, "Parameters", parameters);
            builder.CloseComponent();
        };
    }
}