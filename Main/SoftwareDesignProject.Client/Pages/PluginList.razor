@using MudBlazor

<MudTable Items="@plugins" Dense>
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Premium</MudTh>
    </HeaderContent>
    <RowTemplate Context="plugin">
        <MudTd DataLabel="Name">@plugin.Name</MudTd>
        <MudTd DataLabel="Premium">
            <MudCheckBox @bind-Value="@plugin.IsPremium" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<PluginModel> plugins = new()
    {
        new PluginModel { Name = "Plugin A", IsPremium = true },
        new PluginModel { Name = "Plugin B", IsPremium = false },
        new PluginModel { Name = "Plugin C", IsPremium = true }
    };

    public class PluginModel
    {
        public string Name { get; set; } = string.Empty;
        public bool IsPremium { get; set; }
    }
}
