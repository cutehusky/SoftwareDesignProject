@page "/"
@page "/home"
@page "/signin"
@using Microsoft.AspNetCore.Components.Authorization
@using SoftwareDesignProject.Client.Models

@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Sign In</PageTitle>

<MudContainer Class="pa-4">
    <MudText Typo="Typo.h3" GutterBottom="true">Sign In</MudText>

    <MudTextField Label="Username" @bind-Value="_username" Variant="Variant.Outlined" Adornment="Adornment.Start">
    </MudTextField>

    <MudTextField Label="Password" @bind-Value="_password" Variant="Variant.Outlined" Adornment="Adornment.Start" Type="password">
    </MudTextField>

    <MudStack Spacing="2">
        <MudButton OnClick="Login" Variant="Variant.Filled" FullWidth="true">Login</MudButton>
        <MudButton OnClick="SignUp" Variant="Variant.Outlined" FullWidth="true">Sign Up</MudButton>
    </MudStack>
</MudContainer>

@code {
    private string _username { get; set; } = string.Empty;
    private string _password { get; set; } = string.Empty;

    private async Task Login()
    {
        var response = await HttpClient.PostAsJsonAsync("api/auth/signin", new { 
            Username = _username, 
            Password = _password 
        });

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<JwtResponse>();
            var authStateProvider = (CustomAuthStateProvider)AuthStateProvider;
            await authStateProvider.Login(result.Token);
            NavigationManager.NavigateTo("/dashboard");
        }
        else
        {
            Console.WriteLine("Failed to login", response.StatusCode);
        };        
    }

    private void SignUp()
    {
		NavigationManager.NavigateTo("/signup");
    }
}
