@page "/"
@page "/home"
@page "/signin"

<PageTitle>Sign In</PageTitle>

<MudContainer Class="pa-4">
    <MudText Typo="Typo.h3" GutterBottom="true">Sign In</MudText>

    <MudTextField Label="Username" @bind-Value="Username" Variant="Variant.Outlined" Adornment="Adornment.Start">
    </MudTextField>

    <MudTextField Label="Password" @bind-Value="Password" Variant="Variant.Outlined" Adornment="Adornment.Start" Type="password">
    </MudTextField>

    <MudStack Spacing="2">
        <MudButton OnClick="Login" Variant="Variant.Filled" FullWidth="true">Login</MudButton>
        <MudButton OnClick="SignUp" Variant="Variant.Outlined" FullWidth="true">Sign Up</MudButton>
    </MudStack>
</MudContainer>

@code {
    private string Username { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;

    private void Login()
    {
        // Handle login logic here
    }

    private void SignUp()
    {
        // Handle sign-up logic here
    }
}
