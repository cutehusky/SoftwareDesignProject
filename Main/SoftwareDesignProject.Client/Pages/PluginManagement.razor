@inject IDialogService Dialog
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation
@using CommonDTO
@using SoftwareDesignProject.Client.Components
@using SoftwareDesignProject.Client.Services

<div class="d-flex align-center justify-end">
    <MudButton StartIcon="@Icons.Material.Filled.Add" Class="mx-6 my-3" Variant="Variant.Outlined" Color="Color.Inherit"
               OnClick="@(() => OpenDialogAsync(_maxWidth))"> Add </MudButton>
</div>

<MudTable ServerData="LoadServerData"
          Hover="true" Elevation="0" AllowUnsorted="false">
    <HeaderContent>
        <MudTh><MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="new Func<PluginDTO, object>(x=>x.Category!)" SortLabel="Category">Category</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PluginDTO, object>(x=>x.Name!)" SortLabel="Name">Name</MudTableSortLabel></MudTh>
        <MudTh>Description</MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PluginDTO, object>(x=>x.IsEnabled!)" SortLabel="IsEnabled">Enabled</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PluginDTO, object>(x=>x.IsPremium!)" SortLabel="IsPremium">Premium</MudTableSortLabel></MudTh>
        <MudTh>Action</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Category">@context.Category</MudTd>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Description">@context.Description</MudTd>
        <MudTd DataLabel="Enabled">
            <MudCheckBox @bind-Value="@context.IsEnabled" ReadOnly="true"></MudCheckBox>
        </MudTd>
        <MudTd DataLabel="Premium">
            <MudCheckBox @bind-Value="@context.IsPremium" ReadOnly="true"></MudCheckBox>
        </MudTd>
        <MudTd DataLabel="Action">
            <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="() => Delete(context.PluginId)" aria-label="delete" />
            <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="() => Edit(context, _maxWidth)" aria-label="edit" />
            <MudIconButton Icon="@Icons.Material.Filled.Upgrade" OnClick="() => Upgrade(context, _maxWidth)" aria-label="upgrade" />
            
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[]{ 10, 50, 100}" />
    </PagerContent>
</MudTable>
@code {
    
    private IPluginService? PluginService { get; set; } = null;
    
    private async Task<TableData<PluginDTO>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        PluginService = ServiceProvider.GetService<IPluginService>()!;
        try
        {
            var items = await PluginService.GetList(
                state.Page, state.PageSize, state.SortLabel ?? "", state.SortDirection, "", cancellationToken);
            return new TableData<PluginDTO>
            {
                Items = items.Items,
                TotalItems = items.TotalCount
            };
        } catch (Exception e)
        {
            Console.WriteLine(e);
            return new TableData<PluginDTO>
            {
                Items = new List<PluginDTO>(),
                TotalItems = 0
            };
        }
    }
    
    private Task Upgrade(PluginDTO pluginDto, DialogOptions options)
    {
        var parameters = new DialogParameters
        {
            { "Plugin",  pluginDto}
        };
        return Dialog.ShowAsync<UpgradePluginDialog>("Upgrade Plugin", parameters, options);
    }

    private Task Edit(PluginDTO pluginDto, DialogOptions options)
    {
        var parameters = new DialogParameters
        {
            { "Plugin",  pluginDto}
        };
        return Dialog.ShowAsync<EditPluginDialog>("Edit Plugin", parameters, options);
    }

    private async void Delete(Guid id)
    {
        Console.WriteLine($"deleting : {id}");
        if (PluginService == null)
            return;
        try
        {
            await PluginService.Remove(id);
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        } catch (Exception e)
        {
            
        }
    }
    
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private Task OpenDialogAsync(DialogOptions options)
    {
        return Dialog.ShowAsync<AddPluginDialog>("Add Plugin", options);
    }
}