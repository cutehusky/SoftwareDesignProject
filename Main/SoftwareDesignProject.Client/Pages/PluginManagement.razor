@inject IDialogService Dialog
@using CommonDTO
@using SoftwareDesignProject.Client.Components
@using SoftwareDesignProject.Client.Services
@inject IPluginListLoader PluginListLoader

<div class="d-flex align-center justify-end mb-6">
    <MudButton Variant="Variant.Outlined" Color="Color.Inherit"
               OnClick="@(() => OpenDialogAsync(_maxWidth))"> Add </MudButton>
</div>

<MudTable Items="plugins" Hover="true" SortLabel="Sort By" Elevation="0" AllowUnsorted="false">
    <HeaderContent>
        <MudTh><MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="new Func<PluginDTO, object>(x=>x.Category)">Category</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PluginDTO, object>(x=>x.Name)">Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PluginDTO, object>(x=>x.Description)">Description</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PluginDTO, object>(x=>x.IsEnabled)">Enabled</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PluginDTO, object>(x=>x.IsPremium)">Premium</MudTableSortLabel></MudTh>
        <MudTh>Action</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Category">@context.Category</MudTd>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Description">@context.Description</MudTd>
        <MudTd DataLabel="Enabled">
            <MudCheckBox @bind-Value="@context.IsEnabled"></MudCheckBox>
        </MudTd>
        <MudTd DataLabel="Premium">
            <MudCheckBox @bind-Value="@context.IsPremium"></MudCheckBox>
        </MudTd>
        <MudTd DataLabel="Action">
            <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="() => Delete(context.PluginId)" aria-label="delete" />
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[]{50, 100}" />
    </PagerContent>
</MudTable>
@code {
    private List<PluginDTO> plugins = new();
    protected override async Task OnInitializedAsync()
    {
        var items = await PluginListLoader.GetItem();
        if (items != null)
            plugins = items;
    }

    private void Delete(Guid id)
    {
        Console.WriteLine($"deleting : {id}");
    }
    
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private Task OpenDialogAsync(DialogOptions options)
    {
        return Dialog.ShowAsync<AddPluginDialog>("Add Plugin", options);
    }
}