@using MudBlazor

<MudTable Items="@users" Dense>
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Premium</MudTh>
    </HeaderContent>
    <RowTemplate Context="plugin">
        <MudTd DataLabel="Name">@plugin.Name</MudTd>
        <MudTd DataLabel="Premium">
            <MudCheckBox @bind-Value="@plugin.IsPremium" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<UserModel> users = new()
    {
        new UserModel { Name = "User A", IsPremium = true },
        new UserModel { Name = "User B", IsPremium = false },
        new UserModel { Name = "User C", IsPremium = true }
    };

    public class UserModel
    {
        public string Name { get; set; } = string.Empty;
        public bool IsPremium { get; set; }
    }
}
