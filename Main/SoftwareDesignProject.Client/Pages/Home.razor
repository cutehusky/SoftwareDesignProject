@page "/Home"
@page "/"
@using System.ComponentModel
@using CommonDTO
@using Microsoft.AspNetCore.Components.Authorization
@using SoftwareDesignProject.Client.Services
@using SoftwareDesignProject.Client.Components
@using SoftwareDesignProject.Client.Layout
@inject IServiceProvider ServiceProvider
@inject AuthenticationStateProvider AuthStateProvider

@if (_isLoading)
{
    
}
else
{
    @if (FavoritePlugins.Count > 0)
    {
        <MudText Typo="Typo.h6" Style="margin: 10px"> Favorite Tools</MudText>
        <div class="d-flex flex-grow-1 gap-2 flex-wrap align-center">
            @foreach (var plugin in FavoritePlugins)
            {
                <HomeCardItem
                    Plugin="@plugin"
                    Select="Select"
                    GetSelectedFavoriteIcon="GetSelectedFavoriteIcon"
                    IsAuthorized="@_isAuthorized"/>
            }
        </div>
    }

    <MudText Typo="Typo.h6" Style="margin: 10px"> All Tools</MudText>
    <div class="d-flex flex-grow-1 gap-2 flex-wrap align-center">
        @foreach (var plugin in Plugins)
        {
            <HomeCardItem
                Plugin="@plugin"
                Select="Select"
                GetSelectedFavoriteIcon="GetSelectedFavoriteIcon"
                IsAuthorized="@_isAuthorized"/>
        }
    </div>
}

@code {
    private string GetSelectedFavoriteIcon(Guid pluginId)
    {
        return FavoritePluginIds.Contains(pluginId) ? Icons.Material.Filled.Favorite : Icons.Material.Filled.FavoriteBorder;
    }
    
    private bool _isLoading = true;
    private IComponentRefreshService ComponentRefreshService {get; set;} = null!;
    private IEnumerable<HomeItem> Plugins { get; set; } = [];

    private List<HomeItem> FavoritePlugins { get; set; } = [];

    private HashSet<Guid> FavoritePluginIds { get; set; } = [];
    
    private bool _isAuthorized;

    protected override async Task OnInitializedAsync()
    {
        if (OperatingSystem.IsBrowser())
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAuthorized = authState.User.Identity?.IsAuthenticated == true;
            var navLoader = ServiceProvider.GetService<INavMenuLoader>()!;
            ComponentRefreshService = ServiceProvider.GetService<IComponentRefreshService>()!;
            
            var data = await navLoader.GetHomeItem();
            Plugins = data?.PluginItems ?? [];
            FavoritePluginIds = data?.FavoriteItems ?? [];
            FavoritePlugins = Plugins.Where((item => FavoritePluginIds.Contains(item.PluginId))).ToList();
            _isLoading = false;
        }
    }

    private void Select(Guid pluginId)
    {
        var pluginService = ServiceProvider.GetService<IPluginService>()!;
        if (FavoritePluginIds.Contains(pluginId))
        {
            try
            {
                pluginService.UnstarPlugin(pluginId);
            } catch (Exception e)
            {
                Console.WriteLine(e);
                return;
            }
            FavoritePluginIds.Remove(pluginId);
            var plugin = Plugins.FirstOrDefault(p => p.PluginId == pluginId);
            if (plugin != null)
                FavoritePlugins.Remove(plugin);
            ComponentRefreshService.NotifyStateChanged(this,
                new NavMenu.PluginEventArgs {
                    PluginId = pluginId, 
                    Action = CollectionChangeAction.Remove
                });
        }
        else
        {
            try
            {
                pluginService.StarPlugin(pluginId);
            }
            catch (Exception e)
            {
                Console.WriteLine(e);
                return;
            }

            FavoritePluginIds.Add(pluginId);
            var plugin = Plugins.FirstOrDefault(p => p.PluginId == pluginId);
            if (plugin != null)
                FavoritePlugins.Insert(0, plugin);
            ComponentRefreshService.NotifyStateChanged(this,
                new NavMenu.PluginEventArgs {
                    PluginId = pluginId, 
                    Action = CollectionChangeAction.Add
                });
        }

        StateHasChanged();
    }
}