@page "/Home"
@page "/"
@using CommonDTO
@using Microsoft.AspNetCore.Components.Authorization
@using SoftwareDesignProject.Client.Services
@inject IServiceProvider ServiceProvider
@inject AuthenticationStateProvider AuthStateProvider

@if (_isLoading)
{
    
}
else
{
    @if (FavoritePlugins.Count > 0)
    {
        <MudText Typo="Typo.h6" Style="margin: 10px"> Favorite Tools</MudText>
        <div class="d-flex flex-grow-1 gap-2 flex-wrap align-center">
            @foreach (var plugin in FavoritePlugins)
            {
                <MudCard Width="24%" Style="min-width: 250px; backdrop-filter: blur(5px); opacity: 0.75;">
                    <MudCardHeader style="width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">
                        <MudLink Href="@plugin.Href" Underline="Underline.None" Typo="Typo.h6" Style="width: 100%; text-overflow: ellipsis; overflow: hidden;">@plugin.Text</MudLink>
                        @if(_isAuthorized)
                        {
                            <MudIconButton Style="padding: 3px" OnClick="()=> Select(plugin.PluginId)" Icon="@GetSelectedFavoriteIcon(plugin.PluginId)" Color="Color.Secondary" aria-label="add to favorite"/>
                        }
                    </MudCardHeader>
                    <a href="@plugin.Href">
                        <MudCardContent style="overflow: hidden; height: 100px;">
                            <MudText Style="width: 100%; height: 100%; text-overflow: ellipsis; overflow: hidden;">
                                @plugin.Description
                            </MudText>
                        </MudCardContent>
                    </a>
                </MudCard>
            }
        </div>
    }

    <MudText Typo="Typo.h6" Style="margin: 10px"> All Tools</MudText>
    <div class="d-flex flex-grow-1 gap-2 flex-wrap align-center">
        @foreach (var plugin in Plugins)
        {
            <MudCard Width="24%" Style="min-width: 250px; backdrop-filter: blur(5px); opacity: 0.75;">
                <MudCardHeader style="width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">
                    <MudLink Href="@plugin.Href" Underline="Underline.None" Typo="Typo.h6" Style="width: 100%; text-overflow: ellipsis; overflow: hidden;">@plugin.Text</MudLink>
                    @if (_isAuthorized)
                    {
                        <MudIconButton Style="padding: 3px" OnClick="()=> Select(plugin.PluginId)" Icon="@GetSelectedFavoriteIcon(plugin.PluginId)" Color="Color.Secondary" aria-label="add to favorite"/>
                    }
                </MudCardHeader>
                <a href="@plugin.Href">
                    <MudCardContent style="overflow: hidden; height: 100px;">
                        <MudText Style="width: 100%; height: 100%; text-overflow: ellipsis; overflow: hidden;">
                            @plugin.Description
                        </MudText>
                    </MudCardContent>
                </a>
            </MudCard>
        }
    </div>
}

@code {

    private string GetSelectedFavoriteIcon(Guid pluginId)
    {
        return FavoritePluginIds.Contains(pluginId) ? Icons.Material.Filled.Favorite : Icons.Material.Filled.FavoriteBorder;
    }
    
    private bool _isLoading = true;
    public IEnumerable<HomeItem> Plugins { get; set; } = [];
    
    public List<HomeItem> FavoritePlugins { get; set; } = [];
    
    public HashSet<Guid> FavoritePluginIds { get; set; } = [];

    //private UserRoles? _currentUserRole;
    
    private bool _isAuthorized { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        if (OperatingSystem.IsBrowser())
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            //_currentUserRole = GetUserRole(authState.User);
            _isAuthorized = authState.User.Identity?.IsAuthenticated == true;
            var navLoader = ServiceProvider.GetService<INavMenuLoader>();
            if (navLoader != null)
            {
                var data = await navLoader.GetHomeItem();
                Plugins = data?.PluginItems ?? [];
                FavoritePluginIds = data?.FavoriteItems ?? [];
                FavoritePlugins = Plugins.Where((item => FavoritePluginIds.Contains(item.PluginId))).ToList();
            }
            _isLoading = false;
        }
    }

    private List<HomeItem> FilterPlugins(List<HomeItem> plugins, UserRoles role)
    {
        return role >= UserRoles.Premium
            ? plugins
            : plugins.Where(p => !p.IsPremium).ToList();
    }

    private void Select(Guid pluginId)
    {
        var pluginService = ServiceProvider.GetService<IPluginService>()!;
        if (FavoritePluginIds.Contains(pluginId))
        {
            try
            {
                pluginService.UnstarPlugin(pluginId);
            } catch (Exception e)
            {
                Console.WriteLine(e);
                return;
            }
            FavoritePluginIds.Remove(pluginId);
            var plugin = Plugins.FirstOrDefault(p => p.PluginId == pluginId);
            if (plugin != null)
                FavoritePlugins.Remove(plugin);
        }
        else
        {
            try
            {
                pluginService.StarPlugin(pluginId);
            }
            catch (Exception e)
            {
                Console.WriteLine(e);
                return;
            }

            FavoritePluginIds.Add(pluginId);
            var plugin = Plugins.FirstOrDefault(p => p.PluginId == pluginId);
            if (plugin != null)
                FavoritePlugins.Insert(0, plugin);
        }

        StateHasChanged();
    }
}