@page "/404"

<MudPaper Elevation="3" Class="mx-auto my-8 pa-6 rounded-lg" Style="max-width: 600px; opacity: 0.85; backdrop-filter: blur(10px); border: 1px solid rgba(0, 0, 0, 0.1);">
    <MudStack Spacing="4" AlignItems="AlignItems.Center">
        <MudIcon Icon="@Icons.Material.Filled.Block" Color="Color.Error" Size="Size.Large" Class="mb-4" />
        <MudText Typo="Typo.h4" Color="Color.Error">404 - Not Found</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-4"> The page you are looking for does not exist or has been moved.</MudText>
    </MudStack>
</MudPaper>