@using CommonDTO
@using SoftwareDesignProject.Client.Services
@inject IServiceProvider ServiceProvider

<MudDialog>
    <DialogContent>
        <MudTextField Label="Username"
                      @bind-Value="_username"
                      Required="true"
                      Immediate="true"
                      Class="mb-4 mx-3" 
                      Variant="Variant.Outlined" />

        <MudTextField Label="Password"
                      @bind-Value="_password"
                      InputType="InputType.Password"
                      Required="true"
                      Immediate="true"
                      Class="mb-4 mx-3" 
                      Variant="Variant.Outlined" />

        <MudSelect Label="User Role"
                   @bind-Value="_selectedRole"
                   Class="mb-4 mx-3" 
                   Variant="Variant.Outlined">
            @foreach (UserRoles role in Enum.GetValues(typeof(UserRoles)))
            {
                <MudSelectItem Value="role">@role.ToString()</MudSelectItem>
            }
        </MudSelect>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4 mx-3">@_errorMessage</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Class="mx-3">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Class="mx-3">Create User</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private IUserService UserService { get; set; } = null!;
    private IComponentRefreshService ComponentRefreshService { get; set; } = null!;
    private string _username = "";
    private string _password = "";
    private UserRoles _selectedRole = UserRoles.Normal;
    private string _errorMessage = "";

    protected override void OnInitialized()
    {
        UserService = ServiceProvider.GetService<IUserService>()!;
        ComponentRefreshService = ServiceProvider.GetService<IComponentRefreshService>()!;
    }

    private async Task Submit()
    {
        if (_username.Trim().Length == 0 || _password.Length == 0)
        {
            _errorMessage = "Username and Password cannot be empty.";
            StateHasChanged();
            return;
        }
        
        try
        {
            var newUser = new UserDTO
                {
                    Username = _username,
                    Password = _password, 
                    UserRole = _selectedRole
                };

            await UserService.Add(newUser);
            MudDialog.Close(DialogResult.Ok(true));
            ComponentRefreshService.NotifyStateChanged(this);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            _errorMessage = $"Fail to add user. Reason:{ex.Message}";
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}