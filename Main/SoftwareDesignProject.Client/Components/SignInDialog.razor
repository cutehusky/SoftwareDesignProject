@using CommonDTO
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.DependencyInjection
@using SoftwareDesignProject.Client.Services

@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IServiceProvider ServiceProvider


<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <DialogContent>
        <MudCard Elevation="0">
            <MudCardContent>
                <div class="d-flex flex-column align-center mb-4">
                    <MudIcon Icon="@Icons.Custom.Brands.Steam" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                    <MudText Typo="Typo.h5" Class="mb-4">Welcome Back!</MudText>
                </div>

                <MudForm @ref="_form" @onsubmit="Login" Class="mb-4">
                    <MudTextField Label="Username"
                    @bind-Value="_username"
                    Variant="Variant.Outlined"
                    AdornmentIcon="@Icons.Material.Filled.Person"
                    Adornment="Adornment.Start"
                    Required="true"
                    RequiredError="Username is required"
                    Class="mb-4">
                    </MudTextField>

                    <MudTextField Label="Password"
                    @bind-Value="_password"
                    Variant="Variant.Outlined"
                    AdornmentIcon="@Icons.Material.Filled.Lock"
                    Adornment="Adornment.Start"
                    InputType="InputType.Password"
                    Required="true"
                    RequiredError="Password is required"
                    Class="mb-4">
                    </MudTextField>

                    <MudButton ButtonType="ButtonType.Submit"
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    FullWidth="true"
                    EndIcon="@Icons.Material.Filled.ArrowForward"
                    Disabled="@_isProcessing"
                    Class="mt-4">
                        @(_isProcessing ? "Signing In..." : "Sign In")
                    </MudButton>
                </MudForm>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-2">@_errorMessage</MudAlert>
                }
            </MudCardContent>
        </MudCard>
    </DialogContent>
</MudDialog>

@code {
    [Inject]
    private IDialogService DialogService { get; set; } = null!;
    private IAuthService _authService { get; set; } = null;

    private MudForm _form;
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isProcessing = false;

    private IDialogService _dialogService = null!;
    private NavigationManager _nav = null!;

    protected override void OnInitialized()
    {
        _authService = ServiceProvider.GetService<IAuthService>()!;
    }

 

    private async Task Login()
    {
        _errorMessage = string.Empty;
        _isProcessing = true;

        await _form.Validate();
        if (!_form.IsValid)
        {
            _isProcessing = false;
            return;
        }

        try
        {
            var request = new LoginRequest
                {
                    Username = _username,
                    Password = _password
                };
            var jwtResponse = await _authService.LoginAsync(request);
            var customProv = (CustomAuthStateProvider)AuthStateProvider;
            await customProv.Login(jwtResponse.Token);
            await DialogService.ShowMessageBox("Success", "Signed in successfully");


            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isProcessing = false;
        }
    }
}