@using CommonDTO
@using Microsoft.AspNetCore.Components.Authorization
@using SoftwareDesignProject.Client.Models

@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider

<MudDialog>
    <DialogContent>
        <MudTextField Label="Username" @bind-Value="_username" Variant="Variant.Outlined" Adornment="Adornment.Start">
        </MudTextField>

        <MudTextField Label="Password" @bind-Value="_password" Variant="Variant.Outlined" Adornment="Adornment.Start" Type="password" InputType="InputType.Password">
        </MudTextField>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Login" Variant="Variant.Filled" FullWidth="true">Sign In</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private IDialogService DialogService { get; set; }
    private string _username { get; set; } = string.Empty;
    private string _password { get; set; } = string.Empty;

    private async Task Login()
    {
        var response = await HttpClient.PostAsJsonAsync("api/auth/signin", new LoginRequest()
        {
            username = _username,
            password = _password
        });

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<JwtResponse>();
            var authStateProvider = (CustomAuthStateProvider)AuthStateProvider;
            await authStateProvider.Login(result.Token);
            await DialogService.ShowMessageBox("Success", "Logged in successfully");
            StateHasChanged();
        }
        else
        {
            Console.WriteLine("Failed to login: {0}", response.StatusCode);
            await DialogService.ShowMessageBox("Error", "Failed to login");
            StateHasChanged();
        };
    }

    private void SignUp()
    {
        NavigationManager.NavigateTo("/signup");
    }
}
