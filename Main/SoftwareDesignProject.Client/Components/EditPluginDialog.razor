@using CommonDTO
@using SoftwareDesignProject.Client.Services
@inject NavigationManager Navigation
@inject IServiceProvider ServiceProvider

<MudDialog>
    <DialogContent>

        <div class="d-flex mb-6 justify-lg-space-between">
            <MudTextField 
                @bind-Value="Plugin.Category" 
                Class="mx-3" 
                Required="true"
                Immediate="true"
                Label="Category" 
                Variant="Variant.Outlined" 
                Lines="1" />
            <MudTextField 
                @bind-Value="Plugin.Name" 
                Required="true"
                Immediate="true"
                Class="mx-3" 
                Label="Name" 
                Variant="Variant.Outlined" 
                Lines="1"/>
        </div>

        <MudTextField
            @bind-Value="Plugin.Icon"
            Class="mx-3"
            Label="Icon"
            Placeholder="CSS Class-Based Font Icons or Text-Based Font Icons or SVG"
            Immediate="true"
            Variant="Variant.Outlined"
            Lines="1" />
        
        <MudTextField 
            class="mx-3 my-6" 
            @bind-Value="Plugin.Description" 
            Required="true" 
            Label="Description"
            Immediate="true"
            Variant="Variant.Outlined" 
            Lines="5"/>

        <div class="d-flex my-6">
            <MudSwitch Class="mx-3" 
                       Color="Color.Primary" 
                       Label="Is Premium" 
                       @bind-Value="Plugin.IsPremium"/>
            <MudSwitch Class="mx-3" 
                       Color="Color.Primary" 
                       Label="Is Enabled" 
                       @bind-Value="Plugin.IsEnabled"/>
        </div>
        
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="@Severity.Error" Class="mb-3 mx-3">
                @_errorMessage
            </MudAlert>
        }
    </DialogContent>
    
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>

</MudDialog>

@code {
    [CascadingParameter] 
    private IMudDialogInstance MudDialog { get; set; } = null!;
    
    protected IComponentRefreshService ComponentRefreshService { get; set; } = null!;

    [Parameter] 
    public PluginDTO Plugin { get; set; } = null!;

    private IPluginService PluginService { get; set; } = null!;

    private string _errorMessage = "";

    protected override void OnInitialized()
    {
        PluginService = ServiceProvider.GetService<IPluginService>()!;
        ComponentRefreshService = ServiceProvider.GetService<IComponentRefreshService>()!;
    }

    private async void Submit()
    {
        if (Plugin.Name!.Trim().Length == 0 || 
            Plugin.Description!.Trim().Length == 0 ||
            Plugin.Category!.Trim().Length == 0)
        {
            _errorMessage = "Must fill name, description, category.";
            StateHasChanged();
            return;
        }

        try
        {
            await PluginService.Edit(Plugin);
            MudDialog.Close(DialogResult.Ok(true));
            ComponentRefreshService.NotifyStateChanged(this);
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            _errorMessage = $"Fail to update plugin. Reason: {e.Message}";
            StateHasChanged();
        }
    } 

    private void Cancel() => MudDialog.Cancel();
}