@using SoftwareDesignProject.Client.Models
@using SoftwareDesignProject.Client.Services
@inject IServiceProvider ServiceProvider

<MudDialog>
    <DialogContent>

        <div class="d-flex justify-lg-space-between">
            <MudTextField 
                @bind-Value="_category" 
                Class="mx-3"
                Label="Category" 
                Required="true"
                Immediate="true"
                Variant="Variant.Outlined" 
                Lines="1" />
            <MudTextField 
                @bind-Value="_name" 
                Class="mx-3" 
                Label="Name"
                Required="true"
                Immediate="true"
                Variant="Variant.Outlined" 
                Lines="1"/>
        </div>

        <MudTextField 
            class="mx-3" 
            Required="true"
            Immediate="true"
            @bind-Value="_description" 
            Label="Description" 
            Variant="Variant.Outlined" 
            Lines="5"/>

        <MudSwitch Class="mx-3" 
                   Color="Color.Primary" 
                   Label="Is Premium" 
                   @bind-Value="_isPremium"/>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="@Severity.Error" Class="mb-3 mx-3">
                @_errorMessage
            </MudAlert>
        }
        
        <MudDivider DividerType="DividerType.Middle" Class="my-2"/>

        <div class="my-3 mx-3 d-flex align-center">
            <MudFileUpload T="IBrowserFile" FilesChanged="OnClientDLLFileChanged">
                <ActivatorContent>
                    <MudButton Color="Color.Inherit" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.CloudUpload">
                        Upload Client DLL
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            <div class="mx-6">
                <MudText>@_clientDllName</MudText>
            </div>
            @if (!string.IsNullOrEmpty(_clientDllName))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="OnClientDLLFileRemoved"
                               Color="Color.Error" Size="Size.Small" />
            }
        </div>

        <div class="my-3 mx-3 d-flex align-center">
            <MudFileUpload T="IBrowserFile" FilesChanged="OnServerDLLFileChanged">
                <ActivatorContent>
                    <MudButton Color="Color.Inherit" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.CloudUpload">
                        Upload Server DLL
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            <div class="mx-6">
                <MudText>@_serverDllName</MudText>
            </div>
            @if (!string.IsNullOrEmpty(_serverDllName))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="OnServerDLLFileRemoved"
                               Color="Color.Error" Size="Size.Small" />
            }
        </div>
    </DialogContent>
    
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>

</MudDialog>

@code {
    [CascadingParameter] 
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private IPluginService PluginService { get; set; } = null!;
    protected IComponentRefreshService ComponentRefreshService { get; set; } = null!;
    
    private string _name = "";
    private string _description = "";
    private bool _isPremium;
    private string _errorMessage = "";
    private IBrowserFile? _clientDll;
    private IBrowserFile? _serverDll;
    private string _clientDllName = "";
    private string _serverDllName = "";
    private string _category = "";

    protected override void OnInitialized()
    {
        PluginService = ServiceProvider.GetService<IPluginService>()!;
        ComponentRefreshService = ServiceProvider.GetService<IComponentRefreshService>()!;
    }

    private async void Submit()
    {
        if (_name.Trim().Length == 0 || 
            _description.Trim().Length == 0 ||
            _category.Trim().Length == 0)
        {
            _errorMessage = "Must fill name, description, category.";
            StateHasChanged();
            return;
        }

        if (_clientDll == null)
        {
            _errorMessage = "Must upload client DLL.";
            StateHasChanged();
            return;
        }

        try
        {
            await PluginService.Add(new PluginUploadData()
            {
                Name = _name,
                Description = _description,
                IsPremium = _isPremium,
                ClientDLL = _clientDll,
                ServerDLL = _serverDll,
                Category = _category
            });
            
            MudDialog.Close(DialogResult.Ok(true));
            ComponentRefreshService.NotifyStateChanged(this);
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            _errorMessage = $"Fail to install plugin. Reason: {e.Message}";
            StateHasChanged();
        }
    } 

    private void Cancel() => MudDialog.Cancel();

    public void OnClientDLLFileChanged(IBrowserFile? file)
    {
        if (file != null)
        {
            _clientDll = file;
            _clientDllName = file.Name;
        }
    }
    
    public void OnServerDLLFileChanged(IBrowserFile? file)
    {
        if (file != null)
        {
            _serverDll = file;
            _serverDllName = file.Name;
        }
    }
    
    public void OnClientDLLFileRemoved()
    {
        _clientDll = null;
        _clientDllName = "";
    }
    
    public void OnServerDLLFileRemoved()
    {
        _serverDll = null;
        _serverDllName = "";
    }
}