@using SoftwareDesignProject.Client.Models
@using SoftwareDesignProject.Client.Services
@inject IPublishPlugin PublishPlugin
@inject NavigationManager Navigation

<MudDialog>
    <DialogContent>

        <div class="d-flex align-center justify-lg-space-between">
            <MudTextField width="50%-20px" @bind-Value="_category" Class="mx-3"
                          Label="Category" Variant="Variant.Outlined" Lines="1" ></MudTextField>
            <MudTextField @bind-Value="_name" Class="mx-3" Label="Name" Variant="Variant.Outlined" Lines="1"></MudTextField>
        </div>

        <MudTextField class="my-6 mx-3"  @bind-Value="_description" Label="Description" Variant="Variant.Outlined" Lines="5"></MudTextField>

        <MudCheckBox Label="Is Premium" @bind-Value="_isPremium"/>
        
        <MudAlert Severity="_alertSeverity" Class="mb-3" Style="@AlertStyle">
            @_alertText
        </MudAlert>
        
        <MudDivider DividerType="DividerType.Middle" Class="my-3"/>

        <div class="my-6 mx-3 d-flex align-center">
            <MudFileUpload T="IBrowserFile" FilesChanged="OnClientDLLFileChanged">
                <ActivatorContent>
                    <MudButton Color="Color.Inherit" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.CloudUpload">
                        Upload Client DLL
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            <div class="mx-6">
                <MudText>@_clientDLLName</MudText>
            </div>
        </div>

        <div class="my-6 mx-3 d-flex align-center">
            <MudFileUpload T="IBrowserFile" FilesChanged="OnServerDLLFileChanged">
                <ActivatorContent>
                    <MudButton Color="Color.Inherit" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.CloudUpload">
                        Upload Server DLL
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            <div class="mx-6">
                <MudText>@_serverDLLName</MudText>
            </div>
        </div>
    </DialogContent>
    
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>

</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private Severity _alertSeverity = Severity.Info;
    private bool _showAlert = false;
    private string AlertStyle => _showAlert ? "display: block;" : "display: none;";
    private string _alertText = "";
    private string _name = "";
    private string _description = "";
    private bool _isPremium = false;
    private IBrowserFile? _clientDLL;
    private IBrowserFile? _serverDLL;
    private string _clientDLLName;
    private string _serverDLLName;
    private string _category = "";

    private void ShowAlert(Severity severity, string text)
    {
        _alertSeverity = severity;
        _alertText = text;
        _showAlert = true;
    }

    private async void Submit()
    {
        if (_name.Trim().Length == 0 || 
            _description.Trim().Length == 0 ||
            _category.Trim().Length == 0)
        {
            ShowAlert(Severity.Error, "Must fill name, description, category.");
            return;
        }

        if (_clientDLL == null)
        {
            ShowAlert(Severity.Error, "Must upload client DLL.");
            return;
        }
        
        ShowAlert(Severity.Info, "Loading...");
        
        var res = await PublishPlugin.Submit(new PluginUploadData()
        {
            Name = _name,
            Description = _description,
            IsPremium = _isPremium,
            ClientDLL = _clientDLL,
            ServerDLL = _serverDLL,
            Category = _category
        });

        if (res)
        {
            MudDialog.Close(DialogResult.Ok(true));
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
        else
        {
            ShowAlert(Severity.Error, "Fail to install plugin.");
            StateHasChanged();
        }
    } 

    private void Cancel() => MudDialog.Cancel();

    public void OnClientDLLFileChanged(IBrowserFile? file)
    {
        if (file != null)
        {
            _clientDLL = file;
            _clientDLLName = file.Name;
        }
    }
    
    public void OnServerDLLFileChanged(IBrowserFile? file)
    {
        if (file != null)
        {
            _serverDLL = file;
            _serverDLLName = file.Name;
        }
    }
}