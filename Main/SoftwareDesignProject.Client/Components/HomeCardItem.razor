@using CommonDTO
<style>

    .custom-grid-item {
        flex: 0 0 calc(25% - 16px); /* For 4 items per row */
        padding: 8px;
        box-sizing: border-box;
    }

    @@media (max-width: 600px) {
        .custom-grid-item {
            flex: 0 0 calc(100% - 16px); /* Full width on extra small screens */
        }
    }

    @@media (min-width: 601px) and (max-width: 960px) {
        .custom-grid-item {
            flex: 0 0 calc(50% - 16px); /* 2 items per row on small screens */
        }
    }

    @@media (min-width: 961px) and (max-width: 1280px) {
        .custom-grid-item {
            flex: 0 0 calc(33.333% - 16px); /* 3 items per row on medium screens */
        }
    }
</style>
<MudCard Class="custom-grid-item" Style="min-width: 250px; backdrop-filter: blur(8px); opacity: 0.85;">
    <MudCardHeader style="width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">
        <MudIcon Color="IsPremium" Icon="@Plugin.Icon" Class="me-3"/>
        <MudLink Href="@Plugin.Href" Color="IsPremium" Underline="Underline.None" Typo="Typo.h6" Style="width: 100%; text-overflow: ellipsis; overflow: hidden;">@Plugin.Text</MudLink>
        @if (IsAuthorized)
        {
            <MudIconButton Style="padding: 3px" OnClick="() => Select(Plugin.PluginId)" Icon="@GetSelectedFavoriteIcon(Plugin.PluginId)" Color="Color.Secondary" aria-label="add to favorite"/>
        }
    </MudCardHeader>
    <a href="@Plugin.Href">
        <MudCardContent style="overflow: hidden; height: 100px;">
            <MudText Style="width: 100%; height: 100%; text-overflow: ellipsis; overflow: hidden;">
                @Plugin.Description
            </MudText>
        </MudCardContent>
    </a>
</MudCard>

@code {
    [Parameter] public HomeItem Plugin { get; set; } = null!;
    [Parameter] public Action<Guid> Select { get; set; } = null!;
    [Parameter] public Func<Guid, string> GetSelectedFavoriteIcon { get; set; } = null!;
    [Parameter] public bool IsAuthorized { get; set; }
    private Color IsPremium => Plugin.IsPremium ? Color.Warning : Color.Inherit;
}