@using CommonDTO
@using Microsoft.AspNetCore.Components.Authorization
@using SoftwareDesignProject.Client.Models

@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider

<MudDialog>
    <DialogContent>
        <MudTextField Label="Username" @bind-Value="_username" Variant="Variant.Outlined" Adornment="Adornment.Start">
        </MudTextField>

        <MudTextField Label="Password" @bind-Value="_password" Variant="Variant.Outlined" Adornment="Adornment.Start" Type="password" InputType="InputType.Password">
        </MudTextField>

        <MudTextField Label="Confirm Password" @bind-Value="_confirmpassword" Variant="Variant.Outlined" Adornment="Adornment.Start" Type="password" InputType="InputType.Password" >
        </MudTextField>
    </DialogContent>
    <DialogActions>
            <MudButton OnClick="HandleSignUp" Variant="Variant.Outlined" FullWidth="true">Sign Up</MudButton>
    </DialogActions>
</MudDialog>



@code {
    [Inject] private IDialogService DialogService { get; set; }

    private string _username { get; set; } = string.Empty;
    private string _password { get; set; } = string.Empty;
    private string _confirmpassword { get; set; } = string.Empty;


    private async Task HandleSignUp()
    {
        if (_password != _confirmpassword)
        {
            await DialogService.ShowMessageBox("Error", "Passwords do not match");
            StateHasChanged();
            return;
        }

        var response = await HttpClient.PostAsJsonAsync("api/auth/signup", new RegisterRequest()
        {
            username = _username,
            password = _password
        });

        if (response.IsSuccessStatusCode)
        {
            await DialogService.ShowMessageBox("Success", "Account created successfully");
            StateHasChanged();
            NavigationManager.NavigateTo("/signin");
        }
        else
        {
            Console.WriteLine("Failed to sign up", response);
            await DialogService.ShowMessageBox("Error", "Failed to create account");
            StateHasChanged();
        }
    }
}
