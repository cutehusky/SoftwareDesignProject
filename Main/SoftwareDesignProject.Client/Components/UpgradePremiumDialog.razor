@using Microsoft.AspNetCore.Components.Authorization
@using SoftwareDesignProject.Client.Services
@using System.Security.Claims
@inject IServiceProvider ServiceProvider
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager


<MudDialog>
    <DialogContent>
        <MudText Align="Align.Center">Do you want to upgrade to premium?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="HandleUpgrade" Variant="Variant.Filled" Color="Color.Primary">Yes</MudButton>
        <MudButton OnClick="HandleCancel" Variant="Variant.Outlined" Color="Color.Secondary">No</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] 
    private IDialogService DialogService { get; set; } = null!;
    [CascadingParameter] 
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private CustomAuthStateProvider CustomAuthStateProvider => (CustomAuthStateProvider)AuthProvider;
    private AuthenticationState _authState = null!;
    [CascadingParameter] 
    public Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    protected override async Task OnParametersSetAsync()
    {
        _authState = await AuthenticationStateTask;
    }


    private IUserService UserService { get; set; } = null!;

    protected override void OnInitialized()
    {
        UserService = ServiceProvider.GetService<IUserService>()!;
    }

    private async Task HandleUpgrade()
    {
        var userId = _authState.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Upn)?.Value;
        var token = await CustomAuthStateProvider.GetToken();

        try
        {
            if (Guid.TryParse(userId, out var userGuid))
            {
                await UserService.Upgrade(userGuid);
                var newToken = await UserService.RefreshToken(token); 
                if (!string.IsNullOrEmpty(newToken))
                {
                    await CustomAuthStateProvider.Login(newToken);
                }

                await DialogService.ShowMessageBox("Success", "User upgraded to premium successfully.");
                NavigationManager.NavigateTo("/", forceLoad: true);
                StateHasChanged();
            }
            else
            {
                Console.WriteLine("Invalid UserId format.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }


    private void HandleCancel()
    {
        MudDialog.Close();
    }
}
