@using CommonDTO
@using SoftwareDesignProject.Client.Models
@inject INavMenuLoader NavMenuLoader

<MudNavMenu>
    @foreach (var item in _navItems)
    {
    <MudNavLink Href="@item.Href" Match="NavLinkMatch.Prefix" Icon="@item.Icon">
        @item.Text
    </MudNavLink>
    }
</MudNavMenu>

@code {
    private List<NavItem> _navItems = new();
    protected async override Task OnInitializedAsync()
    {
        var items = await NavMenuLoader.GetNavItem();
        if (items != null)
            _navItems = items;
    }
}
