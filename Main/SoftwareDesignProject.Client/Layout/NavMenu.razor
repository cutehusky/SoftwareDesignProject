@using CommonDTO
@using SoftwareDesignProject.Client.Components
@using SoftwareDesignProject.Client.Pages
@using SoftwareDesignProject.Client.Services
@inject IServiceProvider ServiceProvider
@implements IDisposable

<MudNavMenu Style="padding-top: 10px;">
    @foreach (var category in _navItems)
    {
        @if (category.Item1 != "")
        {
            <MudNavGroup Title="@category.Item1" Expanded="true">
                @foreach (var item in category.Item2)
                {
                    <MudNavLink Href="@item.Href" Match="NavLinkMatch.Prefix" Icon="@item.Icon">
                        @item.Text
                    </MudNavLink>
                }
            </MudNavGroup>
        }
        else
        {
            @foreach (var item in category.Item2)
            {
                <MudNavLink Href="@item.Href" Match="NavLinkMatch.Prefix" Icon="@item.Icon">
                    @item.Text
                </MudNavLink>
            }
        }
    }
</MudNavMenu>

@code {
    private IComponentRefreshService? ComponentRefreshService { get; set; }
    private INavMenuLoader NavMenuLoader { get; set; } = null!;
    
    private List<(string, List<NavItem>)> _navItems = [];

    protected override async Task OnInitializedAsync()
    {
        if (OperatingSystem.IsBrowser())
        {
            NavMenuLoader = ServiceProvider.GetService<INavMenuLoader>()!;
            ComponentRefreshService = ServiceProvider.GetService<IComponentRefreshService>()!;
            ComponentRefreshService.Refresh += Update;

            await Load();
        }
    }

    private async Task Load()
    {
        var items = await NavMenuLoader.GetNavItem();
        var dictionary = new Dictionary<string, List<NavItem>>();
        if (items != null)
        {
            foreach (var item in items)
            {
                if (dictionary.TryGetValue(item.Category.Trim(), out var list))
                {
                    list.Add(item);
                }
                else
                {
                    dictionary.Add(item.Category.Trim(), [item]);
                }
            }
            _navItems = dictionary.Select(kv=> (kv.Key, kv.Value)).ToList();
        }
    }

    private async void Update(object sender, EventArgs? e)
    {
        if (sender is not UserManagement)
        {
            await Load();
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        if (ComponentRefreshService != null) 
            ComponentRefreshService.Refresh -= Update;
    }
}
