@using Microsoft.AspNetCore.Components.Authorization
@using SoftwareDesignProject.Client.Components
@using SoftwareDesignProject.Client.Services
@inherits LayoutComponentBase
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="@_theme" IsDarkMode="@_isDarkMode"/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-background">
    <img src="@BackgroundImage" alt=""/>
</div>

<MudLayout>
    <MudAppBar Elevation="0" Style="backdrop-filter: blur(2px);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
            <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit" Typo="Typo.h5" Class="ml-3">IT TOOLS</MudLink>
            <MudSpacer />
        </MudHidden>
        <SearchBar />
        
        @if (_authState?.User?.Identity?.IsAuthenticated == true)
        {
            @if (_authState.User.IsInRole("Normal"))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Diamond" OnClick="Upgrade"/>
            }
            <MudMenu
                Dense="true"
                AnchorOrigin="Origin.BottomRight">
                <ActivatorContent>
                    <MudAvatar Size="Size.Medium" Class="ma-2" Color="Color.Primary">
                        @_authState.User.Identity.Name?.Substring(0, 1).ToUpper()
                    </MudAvatar>
                </ActivatorContent>
                <ChildContent>
                    <MudText Typo="Typo.subtitle2" Class="px-4 py-2">@_authState.User.Identity.Name</MudText>
                    <MudDivider/>
                    <MudMenuItem Icon="@Icons.Material.Filled.Person">Profile</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Settings">Settings</MudMenuItem>
                    <MudDivider/>
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Logout</MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
        else
        {
            <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
                <MudButton OnClick="OpenSignInDialogAsync">Sign In</MudButton>
                <MudButton OnClick="OpenSignUpDialogAsync">Sign Up</MudButton>
            </MudHidden>
            
            <MudHidden Breakpoint="Breakpoint.SmAndUp">
                <MudTooltip Text="Log in">
                    <MudIconButton Icon="@Icons.Material.Filled.Login" OnClick="OpenSignInDialogAsync"/>
                </MudTooltip>
                <MudTooltip Text="Sign up">
                    <MudIconButton Icon="@Icons.Material.Filled.PersonAdd" OnClick="OpenSignUpDialogAsync"/>
                </MudTooltip>
            </MudHidden>
        }
    
        <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
            <MudTooltip Text="@(_isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")">
                <MudIconButton 
                    Icon="@DarkLightModeButtonIcon" 
                    Color="Color.Inherit" 
                    OnClick="DarkModeToggle" />
            </MudTooltip>
        </MudHidden>
    </MudAppBar>

    <MudDrawer
        @bind-Open="_drawerOpen"
        ClipMode="DrawerClipMode.Always"
        Elevation="2"
        Variant="@DrawerVariant.Responsive"
        Style="backdrop-filter: blur(10px);">
        
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudDrawerHeader>
                <a href="/">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h6" Style="margin-top: 2px; margin-right: 25px" Color="Color.Primary" Class="ml-2">IT TOOLS</MudText>
                        <MudHidden Breakpoint="Breakpoint.SmAndUp">
                            <MudTooltip Text="@(_isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")">
                                <MudIconButton
                                    Icon="@DarkLightModeButtonIcon"
                                    Color="Color.Inherit"
                                    OnClick="DarkModeToggle" />
                            </MudTooltip>
                        </MudHidden>
                    </MudStack>
                </a>
            </MudDrawerHeader>
        </MudHidden>
        <NavMenu/>
    </MudDrawer>
    <MudMainContent Class="mt-16 pa-4">
        @Body
    </MudMainContent>
</MudLayout>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private CustomAuthStateProvider CustomAuthStateProvider => (CustomAuthStateProvider)AuthProvider;
    private AuthenticationState _authState;
    [CascadingParameter]
    public Task<AuthenticationState> AuthenticationStateTask { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _authState = await AuthenticationStateTask;
    }

    private string BackgroundImage  => _isDarkMode ? "img/BackgroundDark.png" : "img/NewBackgroundLight.jpg";
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private MudTheme? _theme;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
            {
                DefaultBorderRadius = "8px"
            }
        };
    }

	private Task Upgrade()
	{
		var options = new DialogOptions { CloseOnEscapeKey = true };
		return DialogService.ShowAsync<UpgradePremiumDialog>("Upgrade", options);
	}

    private async Task Logout()
    {
        await CustomAuthStateProvider.Logout();
        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    private Task OpenSignInDialogAsync()
    {
        var options = new DialogOptions { 
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Small 
        };
        return DialogService.ShowAsync<SignInDialog>("", options);
    }

    private Task OpenSignUpDialogAsync()
    {
        var options = new DialogOptions { 
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Small 
        };
        return DialogService.ShowAsync<SignUpDialog>("", options);
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Black = "#110e2d",
        Surface = "#e4e5f1",
        Background = "#e4e5f1",
        AppbarText = "#424242",
        AppbarBackground = "rgba(228,229,241, 1)",
        DrawerBackground = "rgba(228,229,241, 0.75)",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#7e6fff",
        Surface = "#1e1e2d",
        Background = "#1a1a27",
        BackgroundGray = "#151521",
        AppbarText = "#92929f",
        AppbarBackground = "rgba(26,26,39, 1)",
        DrawerBackground = "rgba(26,26,39, 0.75)",
        ActionDefault = "#74718e",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#605f6d4d",
        TextPrimary = "#b2b0bf",
        TextSecondary = "#92929f",
        TextDisabled = "#ffffff33",
        DrawerIcon = "#92929f",
        DrawerText = "#92929f",
        GrayLight = "#2a2833",
        GrayLighter = "#1e1e2d",
        Info = "#4a86ff",
        Success = "#3dcb6c",
        Warning = "#ffb545",
        Error = "#ff3f5f",
        LinesDefault = "#33323e",
        TableLines = "#33323e",
        Divider = "#292838",
        OverlayLight = "#1e1e2d80",
    };

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.LightMode,
        false => Icons.Material.Rounded.DarkMode,
    };
}

<style>
    .app-background {
        opacity: 0.75; 
        position: fixed; 
        top: 0; 
        left: 0; 
        width: 100%; 
        height: 100%; 
        overflow: hidden; 
        z-index: -2;
    }
    
    .app-background img {
        width: 100%; 
        height: 100%; 
        object-fit: cover;
    }
</style>