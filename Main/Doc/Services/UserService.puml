@startuml
class UserService {
    + UserService(userRepository:IUserRepository, passwordHasher:IPasswordHasher, formatChecker:IFormatChecker)
    + <<async>> GetList(page:int, pageSize:int, sortBy:string, order:SortDirection, search:string) : Task<PaginationList<UserDTO>>
    + <<async>> UpdateUserRole(dto:UserDTO) : Task
    + <<async>> Delete(id:Guid) : Task
    + <<async>> Add(user:UserDTO) : Task
    + <<async>> Upgrade(id:Guid) : Task
    + <<async>> GetById(id:Guid) : Task<UserDTO?>
}
IUserService <|-- UserService
@enduml
