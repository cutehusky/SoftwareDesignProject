@startuml
interface IPluginService {
    + GetList(page:int, pageSize:int, sortBy:string, order:SortDirection, search:string) : Task<PaginationList<PluginDTO>>
    + GetActiveList(userRole:UserRoles?) : Task<List<PluginDTO>>
    + AddPlugin(name:string, description:string, category:string, isPremium:bool, clientDll:IFormFile, serverDll:IFormFile?) : Task
    + EditPlugin(dto:PluginDTO) : Task
    + RemovePlugin(id:Guid) : Task
    + GetPluginById(id:Guid) : Task<PluginDTO?>
    + UpgradePlugin(pluginId:Guid, clientDll:IFormFile?, serverDll:IFormFile?) : Task
    + GetStarredPluginUserById(id:Guid) : Task<List<Guid>>
    + StarPlugin(pluginId:Guid, userId:Guid) : Task
    + UnstarPlugin(pluginId:Guid, userId:Guid) : Task
    + GetClientPluginFile(fileName:string) : Task<FileStream>
    + SearchPlugin(queryValue:string, userRole:UserRoles?) : Task<List<PluginDTO>>
}
@enduml
