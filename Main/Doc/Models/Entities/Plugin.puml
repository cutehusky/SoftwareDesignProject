@startuml
class Plugin {
    + {static} <<readonly>> DefaultCategory : string = "Uncategorized"
    + PluginId : Guid <<get>> <<set>>
    + Name : string <<get>> <<set>>
    + Description : string <<get>> <<set>>
    + Category : string <<get>> <<set>>
    + IsEnabled : bool <<get>> <<set>> = true
    + IsPremium : bool <<get>> <<set>>
    + CreatedAt : DateTime <<get>> <<set>>
    + UpdatedAt : DateTime <<get>> <<set>>
}
ITimestampedEntity <|-- Plugin
@enduml
