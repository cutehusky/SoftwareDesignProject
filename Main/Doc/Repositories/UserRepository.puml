@startuml
class UserRepository {
    + UserRepository(dbContext:AppDbContext)
    + <<async>> GetUserByUsernameAsync(username:string) : Task<UserDTO?>
    + <<async>> GetAll(page:int, pageSize:int, sortBy:string, order:SortDirection, search:string) : Task<PaginationList<UserDTO>>
    + <<async>> GetById(id:Guid) : Task<UserDTO?>
    + <<async>> Add(dto:UserDTO) : Task<bool>
    + <<async>> Remove(id:Guid) : Task<bool>
    + <<async>> Update(userDTO:UserDTO) : Task<bool>
}
IUserRepository <|-- UserRepository
@enduml
