@using MudBlazor


<MudPaper Style="backdrop-filter: blur(5px); opacity: 0.75;" Class="pa-3 mb-4">
    <MudText Typo="Typo.h5" Style="margin: 20px">Temperature Converter</MudText>
    <MudStack>
        <!-- Kelvin -->
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudField Label="Kelvin" Variant="Variant.Filled" />
            <MudNumericField Value="_valueK" Immediate="true" ValueChanged="(double newValue) => ConvertTemp(newValue, 'k')" />"
            <MudField Label="°K" Variant="Variant.Filled" />
        </MudStack>

        <!-- Celsius -->
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudField Label="Celsius" Variant="Variant.Filled" />
			<MudNumericField Value="_valueC" Immediate="true" ValueChanged="(double newValue) => ConvertTemp(newValue, 'c')" />
            <MudField Label="°C" Variant="Variant.Filled" />
        </MudStack>

        <!-- Fahrenheit -->
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudField Label="Fahrenheit" Variant="Variant.Filled" />
            <MudNumericField Value="_valueF" Immediate="true" ValueChanged="(double newValue) => ConvertTemp(newValue, 'f')" />
            <MudField Label="°F" Variant="Variant.Filled" />
        </MudStack>

        <!-- Rankine -->
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudField Label="Rankine" Variant="Variant.Filled" />
            <MudNumericField Value="_valueR" Immediate="true" ValueChanged="(double newValue) => ConvertTemp(newValue, 'r')" />
            <MudField Label="°R" Variant="Variant.Filled" />
        </MudStack>

        <!-- Delisle -->
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudField Label="Delisle" Variant="Variant.Filled" />
            <MudNumericField Value="_valueD" Immediate="true" ValueChanged="(double newValue) => ConvertTemp(newValue, 'd')" />
            <MudField Label="°De" Variant="Variant.Filled" />
        </MudStack>

        <!-- Newton -->
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudField Label="Newton" Variant="Variant.Filled" />
            <MudNumericField Value="_valueN" Immediate="true" ValueChanged="(double newValue) => ConvertTemp(newValue, 'n')" />
            <MudField Label="°N" Variant="Variant.Filled" />
        </MudStack>
    </MudStack>
</MudPaper>


@code {  
   // Temperature values for each scale.  
   private double _valueK;  
   private double _valueC;  
   private double _valueF;  
   private double _valueR;  
   private double _valueD;  
   private double _valueN;  

   protected override void OnInitialized()  
   {  
       ConvertTemp(0, 'k');  
   }  

   /// <summary>  
   /// Handles the conversion based on the type of temperature provided.  
   /// </summary>  
   /// <param name="newValue">New input value.</param>  
   /// <param name="type">Type of the scale input (k, c, f, r, d, n).</param>  
   private void ConvertTemp(double newValue, char type)  
   {  
       double k = 0, c = 0, f = 0, r = 0, d = 0, n = 0;  

       switch (type)  
       {  
           case 'k':  
               k = newValue;  
               c = ConvertKelvinToCelsius(newValue);  
               f = ConvertKelvinToFahrenheit(newValue);  
               r = ConvertKelvinToRankine(newValue);  
               d = ConvertKelvinToDelisle(newValue);  
               n = ConvertKelvinToNewton(newValue);  
               break;  
           case 'c':  
               c = newValue;  
               k = ConvertCelsiusToKelvin(newValue);  
               f = ConvertKelvinToFahrenheit(k);  
               r = ConvertKelvinToRankine(k);  
               d = ConvertKelvinToDelisle(k);  
               n = ConvertKelvinToNewton(k);  
               break;  
           case 'f':  
               f = newValue;  
               k = ConvertFahrenheitToKelvin(newValue);  
               c = ConvertKelvinToCelsius(k);  
               r = ConvertKelvinToRankine(k);  
               d = ConvertKelvinToDelisle(k);  
               n = ConvertKelvinToNewton(k);  
               break;  
           case 'r':  
               r = newValue;  
               k = ConvertRankineToKelvin(newValue);  
               c = ConvertKelvinToCelsius(k);  
               f = ConvertKelvinToFahrenheit(k);  
               d = ConvertKelvinToDelisle(k);  
               n = ConvertKelvinToNewton(k);  
               break;  
           case 'd':  
               d = newValue;  
               k = ConvertDelisleToKelvin(newValue);  
               c = ConvertKelvinToCelsius(k);  
               f = ConvertKelvinToFahrenheit(k);  
               r = ConvertKelvinToRankine(k);  
               n = ConvertKelvinToNewton(k);  
               break;  
           case 'n':  
               n = newValue;  
               k = ConvertNewtonToKelvin(newValue);  
               c = ConvertKelvinToCelsius(k);  
               f = ConvertKelvinToFahrenheit(k);  
               r = ConvertKelvinToRankine(k);  
               d = ConvertKelvinToDelisle(k);  
               break;  
           default:  
               return;  
       }  

       // Update all values with rounding
       _valueK = Math.Round(k, 2);  
       _valueC = Math.Round(c, 2);  
       _valueF = Math.Round(f, 2);  
       _valueR = Math.Round(r, 2);  
       _valueD = Math.Round(d, 2);  
       _valueN = Math.Round(n, 2);  

       StateHasChanged();  
   }  

   // Conversion functions remain the same
   private double ConvertCelsiusToKelvin(double celsius) => celsius + 273.15;  
   private double ConvertFahrenheitToKelvin(double fahrenheit) => (fahrenheit - 32) * 5 / 9 + 273.15;  
   private double ConvertRankineToKelvin(double rankine) => rankine * 5 / 9;  
   private double ConvertDelisleToKelvin(double delisle) => 373.15 - delisle * 2 / 3;  
   private double ConvertNewtonToKelvin(double newton) => newton * 100 / 33 + 273.15;  
   private double ConvertKelvinToCelsius(double kelvin) => kelvin - 273.15;  
   private double ConvertKelvinToFahrenheit(double kelvin) => (kelvin - 273.15) * 9 / 5 + 32;  
   private double ConvertKelvinToRankine(double kelvin) => kelvin * 9 / 5;  
   private double ConvertKelvinToDelisle(double kelvin) => (373.15 - kelvin) * 3 / 2;  
   private double ConvertKelvinToNewton(double kelvin) => (kelvin - 273.15) * 33 / 100;  
}