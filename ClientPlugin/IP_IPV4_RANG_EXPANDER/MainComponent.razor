@using System.Net
@using Microsoft.JSInterop
@using MudBlazor
@inject  IJSRuntime JS


<MudPaper Style="backdrop-filter: blur(5px); opacity: 0.75; "   Class="pa-3 mb-4">
    <MudText Typo="Typo.h5" Style="margin: 20px">IPv4 Range Expander</MudText>
    <div class="my-6 d-flex flex-grow-1 gap-4 justify-center align-center">
        <MudTextField Lines="1" class="my-3" @bind-Value="_ipv4Start" Label="IPv4 Start" Variant="Variant.Outlined"></MudTextField>
        <MudTextField Lines="1" class="my-3" @bind-Value="_ipv4End" Label="IPv4 End" Variant="Variant.Outlined"></MudTextField>
        <MudButton Color="Color.Inherit" Variant="Variant.Outlined" Size="Size.Large" OnClick="Get">Get</MudButton>
    </div>

    @if (!string.IsNullOrEmpty(_alertText))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            @_alertText
        </MudAlert>
    }
</MudPaper>

<MudStack Justify="Justify.Center" Row="true">
    <MudPaper Width="50%" Style="backdrop-filter: blur(5px); opacity: 0.75; "   Class="pa-3 mb-4">
        <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
            <MudTextField class="my-3" @bind-Value="_oldStart" Label="Old Start" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
            <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_oldStart)" />
            </MudTooltip>
        </div>
        
        <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
            <MudTextField class="my-3" @bind-Value="_oldEnd" Label="Old End" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
            <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_oldEnd)" />
            </MudTooltip>
        </div>

        <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
            <MudTextField class="my-3" @bind-Value="_oldSize" Label="Old Count" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
            <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_oldSize)" />
            </MudTooltip>
        </div>
    </MudPaper>

    <MudPaper Width="50%" Style="backdrop-filter: blur(5px); opacity: 0.75; "   Class="pa-3 mb-4">
        <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
            <MudTextField class="my-3" @bind-Value="_newStart" Label="New Start" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
            <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_newStart)" />
            </MudTooltip>
        </div>

        <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
            <MudTextField class="my-3" @bind-Value="_newEnd" Label="New End" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
            <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_newEnd)" />
            </MudTooltip>
        </div>

        <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
            <MudTextField class="my-3" @bind-Value="_newSize" Label="New Count" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
            <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_newSize)" />
            </MudTooltip>
        </div>

        <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
            <MudTextField class="my-3" @bind-Value="_cidr" Label="CIDR" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
            <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_cidr)" />
            </MudTooltip>
        </div>
    </MudPaper>
</MudStack>
@code
{
    private string _ipv4Start = string.Empty;
    private string _ipv4End = string.Empty;
    private string _alertText = string.Empty;
    private bool _showCopyToolTip;
    
    private string _oldStart = string.Empty;
    private string _oldEnd = string.Empty;
    private string _oldSize = string.Empty;

    
    private string _newStart = string.Empty;
    private string _newEnd = string.Empty;
    private string _newSize = string.Empty;
    private string _cidr = string.Empty;
    
    private void Get()
    {
        try {
            var ipStart = IPAddress.Parse(_ipv4Start);
            var ipEnd = IPAddress.Parse(_ipv4End);
            var ipStartInt = IpToUInt32(ipStart);
            var ipEndInt = IpToUInt32(ipEnd);
            var diff = ipStartInt ^ ipEndInt;
            var cidr = 32;
            while (diff != 0)
            {
                diff >>= 1;
                cidr--;
            }
            var mask = 0xFFFFFFFF << (32 - cidr);
            var network = ipStartInt & mask;
            var broadcast = network | ~mask;
            
            _oldStart = ipStart.ToString();
            _oldEnd = ipEnd.ToString();
            _oldSize = (ipEndInt - ipStartInt + 1).ToString();
            _newStart = UInt32ToIp(network);
            _newEnd = UInt32ToIp(broadcast);
            _newSize = (broadcast - network + 1).ToString();
            _cidr = $"{_newStart}/{cidr}";
            
            _alertText = "";
            _showCopyToolTip = true;
        }
        catch (FormatException)
        {
            _alertText = "Invalid IPv4 format.";
            _showCopyToolTip = false;
        }
        catch (Exception ex)
        {
            _alertText = "An unexpected error occurred: " + ex.Message;
            _showCopyToolTip = false;
        }
    }
    
    static uint IpToUInt32(IPAddress ip)
    {
        byte[] bytes = ip.GetAddressBytes();
        if (BitConverter.IsLittleEndian)
            Array.Reverse(bytes);
        return BitConverter.ToUInt32(bytes, 0);
    }
   
    static string UInt32ToIp(uint ip)
    {
        var bytes = BitConverter.GetBytes(ip);
        if (BitConverter.IsLittleEndian)
            Array.Reverse(bytes);
        return new IPAddress(bytes).ToString();
    }
    
    private async Task CopyToClipboard(string textToCopy)
    {
        if (textToCopy.Length > 0)
            await JS.InvokeVoidAsync("copyToClipboard", textToCopy);
    }
}
