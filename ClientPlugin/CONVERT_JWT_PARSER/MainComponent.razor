@using Microsoft.JSInterop
@using MudBlazor
@inject IJSRuntime JS
@using System.IdentityModel.Tokens.Jwt;

<MudPaper Style="backdrop-filter: blur(5px); opacity: 0.75; "   Class="pa-3 mb-4">
    <MudText Typo="Typo.h5" Style="margin: 20px">JWT Parse</MudText>

    <MudTextField Lines="10" AutoGrow="true" class="my-3" 
                  @bind-Value="_jwtInput"
                  Label="Raw" Variant="Variant.Outlined"></MudTextField>
    
    @if (!string.IsNullOrEmpty(_alertText))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            @_alertText
        </MudAlert>
    }

    <MudButton Color="Color.Inherit" Variant="Variant.Outlined" Size="Size.Large" OnClick="DecodeJwt">Decode Jwt</MudButton>
    
    <MudDivider DividerType="DividerType.Middle" Class="my-6"/>

    <MudText Typo="Typo.h6" Style="margin: 20px">Header</MudText>

    <MudTable Items="_headerClaims" T="JwtClaim" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh Style="width: 30%">Type</MudTh>
            <MudTh Style="width: 70%;">Value</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Type">@context.Type</MudTd>
            <MudTd DataLabel="Value">@context.Value</MudTd>
        </RowTemplate>
    </MudTable>

    <MudText Typo="Typo.h6" Style="margin: 20px">Payload</MudText>
    
    <MudTable Items="_payloadClaims" T="JwtClaim" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh Style="width: 30%">Type</MudTh>
            <MudTh Style="width: 70%;">Value</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Type">@context.Type</MudTd>
            <MudTd DataLabel="Value">@context.Value</MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>
@code
{
 
    private string _jwtInput = string.Empty;
    private readonly List<JwtClaim> _headerClaims = new();
    private readonly List<JwtClaim> _payloadClaims = new();
    
    public class JwtClaim
    {
        public string Type { get; set; }
        public string Value { get; set; }
    }
    
    private string _alertText = string.Empty;
    
    private void DecodeJwt()
    {
        _headerClaims.Clear();
        _payloadClaims.Clear();
        try
        {
            var handler = new JwtSecurityTokenHandler();
            var jwt = handler.ReadJwtToken(_jwtInput) as JwtSecurityToken;
            
            foreach (var kv in jwt.Header)
            {
                _headerClaims.Add(new JwtClaim { Type = kv.Key, Value = kv.Value?.ToString() ?? ""});
            }

            foreach (var kv in jwt.Payload)
            {
                _payloadClaims.Add(new JwtClaim { Type = kv.Key, Value = kv.Value?.ToString() ?? "" });
            }
            _alertText = string.Empty;
        }
        catch (Exception ex)
        {
            _alertText = ex.Message;
        }
    }
}