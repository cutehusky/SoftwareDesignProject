@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient HttpClient
<h1>Hashing String to SHA1</h1>
<div class="d-flex flex-grow-1 gap-4 justify-center align-center">
    <MudTextField @bind-Value="_inputHashSHA1" Label="Raw" Variant="Variant.Outlined" Width="50%" Lines="10"></MudTextField>
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="HashSHA1" Height="50px">To >></MudButton>
    <MudTextField @bind-Value="_outputHashSHA1" Label="Hashed" Variant="Variant.Outlined" Width="50%" Lines="10" ReadOnly="true" ></MudTextField>
</div>
<h1>Hashing String to SHA256</h1>
<div class="d-flex flex-grow-1 gap-4 justify-center align-center">
    <MudTextField @bind-Value="_inputHashSHA256" Label="Raw" Variant="Variant.Outlined" Width="50%" Lines="10"></MudTextField>
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="HashSHA256" Height="50px">To >></MudButton>
    <MudTextField @bind-Value="_outputHashSHA256" Label="Hashed" Variant="Variant.Outlined" Width="50%" Lines="10" ReadOnly="true" ></MudTextField>
</div>
<h1>Hashing String to SHA512</h1>
<div class="d-flex flex-grow-1 gap-4 justify-center align-center">
    <MudTextField @bind-Value="_inputHashSHA512" Label="Raw" Variant="Variant.Outlined" Width="50%" Lines="10"></MudTextField>
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="HashSHA512" Height="50px">To >></MudButton>
    <MudTextField @bind-Value="_outputHashSHA512" Label="Hashed" Variant="Variant.Outlined" Width="50%" Lines="10" ReadOnly="true" ></MudTextField>
</div>
@code
{
    private string _inputHashSHA1;
    private string _outputHashSHA1;
    
    private string _inputHashSHA256;
    private string _outputHashSHA256;
    
    private string _inputHashSHA512;
    private string _outputHashSHA512;

    private async void HashSHA1()
    {
        Console.WriteLine(_inputHashSHA1);
        Console.WriteLine(Config.apiEndPoint);

        var response = await HttpClient.PostAsJsonAsync(
            Config.apiEndPoint + "/HashSHA/hash", new HashSHARequest()
            {
                value = _inputHashSHA1,
                type = "sha1"
            });

        if (response.IsSuccessStatusCode)
        {
            var responseData = await response.Content.ReadFromJsonAsync<HashSHAResponse>();
            // Console.WriteLine("Response: " + responseData);
            _outputHashSHA1 = responseData.value;
            StateHasChanged();
        }
        else
        {
            Console.WriteLine("Error: " + response.StatusCode);
        }
    }
    
    private async void HashSHA256()
    {
        Console.WriteLine(_inputHashSHA256);
        Console.WriteLine(Config.apiEndPoint);

        var response = await HttpClient.PostAsJsonAsync(
            Config.apiEndPoint + "/HashSHA/hash", new HashSHARequest()
            {
                value = _inputHashSHA256,
                type = "sha256"
            });

        if (response.IsSuccessStatusCode)
        {
            var responseData = await response.Content.ReadFromJsonAsync<HashSHAResponse>();
            // Console.WriteLine("Response: " + responseData);
            _outputHashSHA256 = responseData.value;
            StateHasChanged();
        }
        else
        {
            Console.WriteLine("Error: " + response.StatusCode);
        }
    }
    
    private async void HashSHA512()
    {
        Console.WriteLine(_inputHashSHA512);
        Console.WriteLine(Config.apiEndPoint);

        var response = await HttpClient.PostAsJsonAsync(
            Config.apiEndPoint + "/HashSHA/hash", new HashSHARequest()
            {
                value = _inputHashSHA512,
                type = "sha512"
            });

        if (response.IsSuccessStatusCode)
        {
            var responseData = await response.Content.ReadFromJsonAsync<HashSHAResponse>();
            // Console.WriteLine("Response: " + responseData);
            _outputHashSHA512 = responseData.value;
            StateHasChanged();
        }
        else
        {
            Console.WriteLine("Error: " + response.StatusCode);
        }
    }
}