@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using MudBlazor
@inject HttpClient HttpClient
@inject IJSRuntime JS

<h1>Hashing File</h1>

<h2 class="my-6">Input</h2>

<div class="d-flex flex-grow-1 gap-4 justify-center align-center">
    <MudSelect T="string" Variant="Variant.Outlined" Label="Select Type" @bind-SelectedValues="_selectedType">
        @foreach (var type in types)
        {
            <MudSelectItem Value="type">@type</MudSelectItem>
        }
    </MudSelect>

    <MudFileUpload T="IBrowserFile" Label="Upload File"
                   FilesChanged="OnFilesChanged">
        <ActivatorContent>
            <MudButton Color="Color.Inherit" Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.CloudUpload">
                Upload File
            </MudButton>
        </ActivatorContent>
    </MudFileUpload>
</div>

<MudDivider id="target" DividerType="DividerType.Middle" Class="my-6"/>

<h2 class="my-6">Result</h2>

<MudAlert Severity="Severity.Error" Class="mb-3" Style="@_alertStyle">
    @_alertText
</MudAlert>

<div class="d-flex flex-grow-1 gap-4 justify-center align-center">
    <MudTextField class="my-6" @bind-Value="_outputMD5Hash" Label="MD5" Variant="Variant.Outlined" Lines="1" ReadOnly="true" ></MudTextField>
    <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_outputMD5Hash)" />
    </MudTooltip>
</div>

<div class="d-flex flex-grow-1 gap-4 justify-center align-center">
    <MudTextField class="my-6" @bind-Value="_outputSHA1Hash" Label="SHA1" Variant="Variant.Outlined" Lines="1" ReadOnly="true" ></MudTextField>
    <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_outputSHA1Hash)"/>
    </MudTooltip>
</div>

<div class="d-flex flex-grow-1 gap-4 justify-center align-center">
    <MudTextField class="my-6" @bind-Value="_outputSHA256Hash" Label="SHA256" Variant="Variant.Outlined" Lines="1" ReadOnly="true" ></MudTextField>
    <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_outputSHA256Hash)"/>
    </MudTooltip>
</div>

<div class="d-flex flex-grow-1 gap-4 justify-center align-center">
    <MudTextField class="my-6" @bind-Value="_outputSHA384Hash" Label="SHA384" Variant="Variant.Outlined" Lines="1" ReadOnly="true" ></MudTextField>
    <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_outputSHA384Hash)"/>
    </MudTooltip>
</div>

<div class="d-flex flex-grow-1 gap-4 justify-center align-center">
    <MudTextField class="my-6" @bind-Value="_outputSHA512Hash" Label="SHA512" Variant="Variant.Outlined" Lines="1" ReadOnly="true" ></MudTextField>
    <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_outputSHA512Hash)"/>
    </MudTooltip>
</div>

<div class="d-flex flex-grow-1 gap-4 justify-center align-center">
    <MudTextField class="my-6" @bind-Value="_outputSHA3_256Hash" Label="SHA3-256" Variant="Variant.Outlined" Lines="1" ReadOnly="true" ></MudTextField>
    <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_outputSHA3_256Hash)"/>
    </MudTooltip>
</div>

<div class="d-flex flex-grow-1 gap-4 justify-center align-center">
    <MudTextField class="my-6" @bind-Value="_outputSHA3_384Hash" Label="SHA3-384" Variant="Variant.Outlined" Lines="1" ReadOnly="true" ></MudTextField>
    <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_outputSHA3_384Hash)"/>
    </MudTooltip>
</div>

<div class="d-flex flex-grow-1 gap-4 justify-center align-center">
    <MudTextField class="my-6" @bind-Value="_outputSHA3_512Hash" Label="SHA3-512" Variant="Variant.Outlined" Lines="1" ReadOnly="true" ></MudTextField>
    <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_outputSHA3_512Hash)"/>
    </MudTooltip>
</div>

@code
{
    private static List<string> types = new List<string>() { "Bin", "Hex", "Base64", "Base64url" };
    private IEnumerable<string> _selectedType = new List<string>() {types[1] };
    
    private string _inputHash = "";
    private string _outputMD5Hash = "";
    private string _outputSHA1Hash = "";
    private string _outputSHA256Hash = "";
    private string _outputSHA384Hash = "";
    private string _outputSHA512Hash = "";
    private string _outputSHA3_256Hash = "";
    private string _outputSHA3_384Hash = "";
    private string _outputSHA3_512Hash = "";
    private bool _showAlert = false;
    private bool _showCopyToolTip = false;
    private string _alertStyle => _showAlert ? "display: block;" : "display: none;";
    private string _alertText = "";
    private bool scrollTo = false;

    private async void OnFilesChanged(IBrowserFile? file)
    {
        if (file == null)
            return;
        
        var selectedType = "";
        foreach (var type in _selectedType)
        {
            selectedType = type; 
            break; // only 1 selection
        }
        
        var fileStream = file.OpenReadStream(file.Size + 1);
        var content = new StreamContent(fileStream);
        content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

        var multipartContent = new MultipartFormDataContent();
        multipartContent.Add(content, "file", file.Name);
        multipartContent.Add(new StringContent(selectedType), "type");
        
        var response = await HttpClient.PostAsync(Config.apiEndPoint + "/Hash/hash", multipartContent);

        if (response.IsSuccessStatusCode)
        {
            var responseData = await response.Content.ReadFromJsonAsync<HashResponse>();
            if (responseData != null)
            {
                _alertText = "";
                SetData(responseData);
            }
            else
            {
                _alertText = "Error: Unknown error";
                Reset();
            }
        }
        else
        {
            _alertText = "Error: " + response.StatusCode;
            Reset();
        }
        
        scrollTo = true;
        StateHasChanged();
    }

    private async Task ScrollToTarget()
    {
        await JS.InvokeVoidAsync("scrollToElement", "target");
    }

    private async Task CopyToClipboard(string textToCopy)
    {
        if (textToCopy.Length > 0)
            await JS.InvokeVoidAsync("copyToClipboard", textToCopy);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollTo)
        {
            scrollTo = false;
            await ScrollToTarget();
        }
    }
    
    private void SetData(HashResponse responseData)
    {
        _outputMD5Hash = responseData.hashMD5;
        _outputSHA1Hash = responseData.hashSHA1;
        _outputSHA256Hash = responseData.hashSHA256;
        _outputSHA384Hash = responseData.hashSHA384;
        _outputSHA512Hash = responseData.hashSHA512;
        _outputSHA3_256Hash = responseData.hashSHA3_256;
        _outputSHA3_384Hash = responseData.hashSHA3_384;
        _outputSHA3_512Hash = responseData.hashSHA3_512;
        _showAlert = false;
        _showCopyToolTip = true;
    }

    private void Reset()
    {
        _showAlert = true;
        _showCopyToolTip = false;
        _outputMD5Hash = "";
        _outputSHA1Hash = "";
        _outputSHA256Hash = "";
        _outputSHA384Hash = "";
        _outputSHA512Hash = "";
        _outputSHA3_256Hash = "";
        _outputSHA3_384Hash = "";
        _outputSHA3_512Hash = "";
    }
}
