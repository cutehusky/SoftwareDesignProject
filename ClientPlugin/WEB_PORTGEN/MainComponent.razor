@using MudBlazor
@using Microsoft.JSInterop
<MudPaper Style="backdrop-filter: blur(5px); opacity: 0.75; " Class="pa-3 mb-4">
    <MudText Typo="Typo.h5" Style="margin: 20px">Random Port Generator</MudText>

    <MudStack AlignItems="AlignItems.Center">
        <MudTextField Label="Generated Port" ReadOnly="true" Variant="Variant.Filled" @bind-Value="_port" />

        <MudStack Row=true Spacing="2" Class="mt-4">
            <MudButton OnClick="GeneratePort" Variant="Variant.Filled" Color="Color.Primary">
                Generate
            </MudButton>
            <MudButton OnClick="CopyToClipboard" Variant="Variant.Outlined" Color="Color.Secondary">
                Copy
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private string _port = string.Empty;

    protected override void OnInitialized()
    {
        GeneratePort();
    }

    private void GeneratePort()
    {
        Random random = new();
        _port = random.Next(1024, 65535).ToString(); 
    }

    private async Task CopyToClipboard()
    {
        if (!string.IsNullOrEmpty(_port))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _port);
        }
    }
}
