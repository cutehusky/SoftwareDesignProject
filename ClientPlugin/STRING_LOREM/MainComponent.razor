@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient HttpClient
<MudPaper Style="backdrop-filter: blur(5px); opacity: 0.75; "   Class="pa-3 mb-4">
    <MudText Typo="Typo.h5" Style="margin: 20px">Generate Lorem Ispum</MudText>

    <MudNumericField @bind-Value="_inputLength"></MudNumericField>
    <MudButton Variant="Variant.Filled" OnClick="Lorem" Height="50px">Generate</MudButton>
    <MudTextField @bind-Value="_outputLorem" Label="Lorem ispum..." Variant="Variant.Outlined" Width="50%" Lines="10" ReadOnly="true" ></MudTextField>
</MudPaper>
@code
{
    private int _inputLength;
    private string _outputLorem = String.Empty;

    private async void Lorem()
    {
        Console.WriteLine(_inputLength);
        Console.WriteLine(Config.apiEndPoint);

        var response = await HttpClient.PostAsJsonAsync(
            Config.apiEndPoint + "/StringLorem/lorem", new StringLoremRequest()
            {
                value = _inputLength.ToString(),
                type = "lorem"
            });

        if (response.IsSuccessStatusCode)
        {
            var responseData = await response.Content.ReadFromJsonAsync<StringLoremResponse>();
            Console.WriteLine("Response: " + responseData);
            _outputLorem = responseData.value;
            StateHasChanged();
        }
        else
        {
            Console.WriteLine("Error: " + response.StatusCode);
        }
    }
}
