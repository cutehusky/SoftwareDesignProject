@using MudBlazor
@using System.Text

<MudPaper Style="backdrop-filter: blur(5px); opacity: 0.75;" Class="pa-3 mb-4">
    <MudText Typo="Typo.h5" Style="margin: 20px">Generate Lorem Ipsum</MudText>

    <MudNumericField @bind-Value="_inputLength" Label="Number of Words" Variant="Variant.Filled" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateLorem" Height="50px" Class="mt-2">Generate</MudButton>
    <MudTextField @bind-Value="_outputLorem" Label="Lorem ipsum..." Variant="Variant.Outlined" Width="50%" Lines="10" ReadOnly="true" Class="mt-2" />
</MudPaper>

@code {
    private int _inputLength;
    private string _outputLorem = string.Empty;

    /// <summary>
    /// Generates Lorem Ipsum text based on the number of words entered.
    /// </summary>
    private void GenerateLorem()
    {
        _outputLorem = GenerateLoremIpsum(_inputLength);
    }

    // Array of lorem ipsum words.
    private readonly string[] LoremWords =
    {
        "lorem", "ipsum", "dolor", "sit", "amet", "consectetur", "adipiscing", "elit",
        "sed", "do", "eiusmod", "tempor", "incididunt", "ut", "labore", "et", "dolore",
        "magna", "aliqua"
    };

    /// <summary>
    /// Generates a Lorem Ipsum string with the specified number of words.
    /// </summary>
    /// <param name="length">The number of words to generate.</param>
    /// <returns>A Lorem Ipsum string.</returns>
    private string GenerateLoremIpsum(int length)
    {
        if (length <= 0)
        {
            return string.Empty;
        }

        var random = new Random();
        var sb = new StringBuilder();

        for (int i = 0; i < length; i++)
        {
            if (i > 0)
            {
                sb.Append(" ");
            }
            string word = LoremWords[random.Next(LoremWords.Length)];
            sb.Append(word);
        }

        return sb.ToString();
    }
}
