@using System.Net
@using Microsoft.JSInterop
@using MudBlazor
@inject  IJSRuntime JS

<MudPaper Style="backdrop-filter: blur(5px); opacity: 0.75; "   Class="pa-3 mb-4">
    <MudText Typo="Typo.h5" Style="margin: 20px">IPv4 Subnet Calculator</MudText>
    <div class="my-6 d-flex flex-grow-1 gap-4 justify-center align-center">
        <MudTextField Lines="1" class="my-3" @bind-Value="_ipv4" Label="IPv4" Variant="Variant.Outlined"></MudTextField>
        <MudButton Color="Color.Inherit" Variant="Variant.Outlined" Size="Size.Large" OnClick="Get">Get</MudButton>
    </div>

    @if (!string.IsNullOrEmpty(_alertText))
    {
    <MudAlert Severity="Severity.Error" Class="mb-3">
        @_alertText
    </MudAlert>
    }
    
    <MudDivider DividerType="DividerType.Middle" Class="my-6"/>

    <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
        <MudTextField class="my-3" @bind-Value="_netmask" Label="Netmask" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
        <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_netmask)" />
        </MudTooltip>
    </div>
    
    <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
        <MudTextField class="my-3" @bind-Value="_networkAddress" Label="Network Address" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
        <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_networkAddress)" />
        </MudTooltip>
    </div>

    <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
        <MudTextField class="my-3" @bind-Value="_broadcastAddress" Label="Broadcast Address" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
        <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_broadcastAddress)" />
        </MudTooltip>
    </div>
    
    <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
        <MudTextField class="my-3" @bind-Value="_networkMask" Label="Network Mask" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
        <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_networkMask)" />
        </MudTooltip>
    </div>
    
    <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
        <MudTextField class="my-3" @bind-Value="_binaryNetworkMask" Label="Binary Network Mask" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
        <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_binaryNetworkMask)" />
        </MudTooltip>
    </div>
    
    <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
        <MudTextField class="my-3" @bind-Value="_wildcardMask" Label="Wildcard Mask" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
        <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_wildcardMask)" />
        </MudTooltip>
    </div>
    
    <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
        <MudTextField class="my-3" @bind-Value="_binaryWildcardMask" Label="Binary Wildcard Mask" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
        <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_binaryWildcardMask)" />
        </MudTooltip>
    </div>
    
    <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
        <MudTextField class="my-3" @bind-Value="_cidrNotation" Label="CIDR Notation" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
        <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_cidrNotation)" />
        </MudTooltip>
    </div>
    
    <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
        <MudTextField class="my-3" @bind-Value="_networkSize" Label="Network Size" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
        <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_networkSize)" />
        </MudTooltip>
    </div>
    
    <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
        <MudTextField class="my-3" @bind-Value="_ipClass" Label="IP Class" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
        <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_ipClass)" />
        </MudTooltip>
    </div>
    
    <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
        <MudTextField class="my-3" @bind-Value="_firstUsable" Label="First Usable" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
        <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_firstUsable)" />
        </MudTooltip>
    </div>
    
    <div class="d-flex flex-grow-1 gap-4 justify-center align-center">
        <MudTextField class="my-3" @bind-Value="_lastUsable" Label="Last Usable" Variant="Variant.Outlined" ReadOnly="true" Lines="1"></MudTextField>
        <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_lastUsable)" />
        </MudTooltip>
    </div>
</MudPaper>

@code
{
    private string _ipv4 = string.Empty;
    private string _alertText = string.Empty;
    private bool _showCopyToolTip;
    
    private string _netmask = string.Empty;
    private string _networkAddress = string.Empty;
    private string _broadcastAddress = string.Empty;
    private string _networkMask = string.Empty;
    private string _binaryNetworkMask = string.Empty;
    private string _wildcardMask = string.Empty;
    private string _binaryWildcardMask = string.Empty;
    private string _cidrNotation = string.Empty;
    private string _networkSize = string.Empty;
    private string _ipClass = string.Empty;
    private string _firstUsable = string.Empty;
    private string _lastUsable = string.Empty;

    private void Get()
    {
        try {

            var ipnet = IPNetwork2.Parse(_ipv4);
            var netmask = ipnet.Netmask;
            var netmaskBytes = netmask.GetAddressBytes();
            var wildcardMaskBytes = GetWildcardMask(netmask);
            
            _netmask = $"{ipnet.Network}/{ipnet.Cidr}";
            _networkAddress = ipnet.Network.ToString();
            _broadcastAddress = ipnet.Broadcast.ToString();
            _networkMask = GetByteArrayString(netmaskBytes);
            _binaryNetworkMask = GetBinary(netmaskBytes);
            _wildcardMask = GetByteArrayString(wildcardMaskBytes);
            _binaryWildcardMask = GetBinary(wildcardMaskBytes);
            _cidrNotation = ipnet.Cidr.ToString();
            _networkSize = ipnet.Usable.ToString();
            _ipClass = GetIpClass(ipnet.Network);
            _firstUsable = ipnet.FirstUsable.ToString();
            _lastUsable = ipnet.LastUsable.ToString();
            
            _alertText = "";
            _showCopyToolTip = true;
        }
        catch (FormatException)
        {
            _alertText = "Invalid IPv4 format.";
            _showCopyToolTip = false;
        }
        catch (Exception ex)
        {
            _alertText = "An unexpected error occurred: " + ex.Message;
            _showCopyToolTip = false;
        }
    }
    
    static byte[] GetWildcardMask(IPAddress netmask)
    {
        byte[] maskBytes = netmask.GetAddressBytes();
        return maskBytes.Select(b => (byte)(255 - b)).ToArray();
    }
    
    static string GetByteArrayString(byte[] bytes)
    {
        return string.Join(".", bytes);
    }
    
    static string GetBinary(byte[] bytes)
    {
        return string.Join(".", bytes.Select(b => Convert.ToString(b, 2).PadLeft(8, '0')));
    }  
    
    static string GetIpClass(IPAddress ip)
    {
        byte firstOctet = ip.GetAddressBytes()[0];
        return firstOctet switch
        {
            0 => "system network management",
            <= 126 => "A",
            127 => "Loopback",
            <= 191 => "B",
            <= 223 => "C",
            <= 239 => "D",
            _ => "E"
        };
    }
    
    private async Task CopyToClipboard(string textToCopy)
    {
        if (textToCopy.Length > 0)
            await JS.InvokeVoidAsync("copyToClipboard", textToCopy);
    }
}
