@using MudBlazor

<MudPaper Style="backdrop-filter: blur(5px); opacity: 0.75;" Class="pa-3 mb-4">
    <MudText Typo="Typo.h5" Style="margin: 20px">Obsfucate String</MudText>

    <!-- Input Field -->
    <MudTextField @bind-Value="_inputValue" Label="Input string here..." Variant="Variant.Outlined" Lines="1" />

    <!-- Numeric Fields for Start and End values -->
    <MudStack Row="true" Spacing="2">
        <MudNumericField Min="0" @bind-Value="_start" Label="Start Index" Variant="Variant.Filled" />
        <MudNumericField Min="0" @bind-Value="_end" Label="End Count" Variant="Variant.Filled" />
    </MudStack>

    <!-- Generate Button -->
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Generate" Height="50px" Class="mt-2">Generate</MudButton>

    <!-- Output Field -->
    <MudTextField @bind-Value="_outputValue" Label="Obsfucated String" Variant="Variant.Outlined" Width="50%" Lines="1" ReadOnly="true" Class="mt-2" />
</MudPaper>

@code {
    private int _start;
    private int _end;
    private string _inputValue = string.Empty;
    private string _outputValue = string.Empty;

    /// <summary>
    /// Handles the button click event, obfuscating the input string.
    /// </summary>
    private void Generate()
    {
        _outputValue = Obsfucate(_inputValue, _start, _end);
    }

    /// <summary>
    /// Replaces a character at a specified index in the input string.
    /// </summary>
    /// <param name="input">The original string.</param>
    /// <param name="index">Position where the replacement should occur.</param>
    /// <param name="newChar">The character that will replace the original.</param>
    /// <returns>A new string with the replaced character.</returns>
    private string ReplaceAt(string input, int index, char newChar)
    {
        if (string.IsNullOrEmpty(input))
        {
            throw new ArgumentNullException(nameof(input));
        }
        // Convert string to a character array.
        char[] chars = input.ToCharArray();
        // Ensure the index is within the bounds of the character array.
        if (index >= 0 && index < chars.Length)
        {
            chars[index] = newChar;
        }
        return new string(chars);
    }

    /// <summary>
    /// Obsfucates the input string by replacing characters with '*' before the start index
    /// and after leaving 'end' characters at the tail end unaltered.
    /// </summary>
    /// <param name="value">The string to be obfuscated.</param>
    /// <param name="start">Number of characters from the beginning to obfuscate.</param>
    /// <param name="end">Number of characters at the end that will remain unaltered.</param>
    /// <returns>The obfuscated string.</returns>
    private string Obsfucate(string value, int start, int end)
    {
        if (string.IsNullOrEmpty(value))
            return string.Empty;

        // Start with the original string.
        string newValue = value;

        // Replace characters from the start of the string up to 'start'
        for (int i = 0; i < Math.Min(value.Length, start); i++)
        {
            newValue = ReplaceAt(newValue, i, '*');
        }

        // Replace characters from the point where only 'end' characters remain unaltered
        for (int i = Math.Min(value.Length, value.Length - end); i < value.Length; i++)
        {
            newValue = ReplaceAt(newValue, i, '*');
        }

        return newValue;
    }
}
