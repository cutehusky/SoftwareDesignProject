@using MudBlazor
@using System.Net

<MudPaper Style="backdrop-filter: blur(5px); opacity: 0.75; "   Class="pa-3 mb-4">
    <MudText Typo="Typo.h5" Style="margin: 20px">URL Encoder/Decoder</MudText>

    <MudStack AlignItems="AlignItems.Center">
        <!-- Encode Section -->
        <MudText Typo="Typo.subtitle1" Class="mt-2">Encode</MudText>
        <MudTextField Label="Enter text to encode" Value="_inputText" Immediate="true" Variant="Variant.Filled" T="string" ValueChanged="(newVal) => EncodeText(newVal)" />
        <MudTextField Label="Encoded URL" ReadOnly="true" Variant="Variant.Filled" Value="@_encodedText" />

        <!-- Decode Section -->
        <MudText Typo="Typo.subtitle1" Class="mt-4">Decode</MudText>
        <MudTextField Label="Enter URL-encoded text" Value="_inputEncodedText" Immediate="true" Variant="Variant.Filled" T="string" ValueChanged="(newVal) => DecodeText(newVal)" />
        <MudTextField Label="Decoded text" ReadOnly="true" Variant="Variant.Filled" Value="@_decodedText" />
    </MudStack>
    
</MudPaper>

@code {
    private string _inputText = string.Empty;
    private string _encodedText = string.Empty;
    private string _inputEncodedText = string.Empty;
    private string _decodedText = string.Empty;

    private void EncodeText(string newVal)
    {
        _inputText = newVal;
        _encodedText = Uri.EscapeDataString(_inputText);
    }

    private void DecodeText(string newVal)
    {
        _inputEncodedText = newVal;
        _decodedText = Uri.UnescapeDataString(_inputEncodedText);
    }
}
