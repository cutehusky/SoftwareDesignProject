@using System.Net.Http.Json
@using Microsoft.JSInterop
@inject IJSRuntime JS
@using MudBlazor
@inject HttpClient HttpClient

<MudPaper Style="backdrop-filter: blur(5px); opacity: 0.75; "   Class="pa-3 mb-4">
    <MudText Typo="Typo.h5" Style="margin: 20px">Generate RSA Key</MudText>
    <div class="my-6 d-flex flex-grow-1 gap-4 justify-center align-start">
        <MudSelect T="int" Class="my-3" @bind-SelectedValues="_keySize" Label="Key Size" Variant="Variant.Outlined">
            <MudSelectItem Value="512">512</MudSelectItem>
            <MudSelectItem Value="1024">1024</MudSelectItem>
            <MudSelectItem Value="2048">2048</MudSelectItem>
            <MudSelectItem Value="3072">3072</MudSelectItem>
            <MudSelectItem Value="4096">4096</MudSelectItem>
        </MudSelect>
        <MudSelect T="string" Class="my-3" @bind-SelectedValues="_keyOptions" Label="Key Format" Variant="Variant.Outlined">
            <MudSelectItem Value="XmlKey">@XmlKey</MudSelectItem>
            <MudSelectItem Value="PemKey">@PemKey</MudSelectItem>
        </MudSelect>
        <MudButton Class="my-3" Color="Color.Inherit" Variant="Variant.Outlined" Size="Size.Large" OnClick="Encrypt">Get</MudButton>
    </div>
    
    @if (!string.IsNullOrEmpty(_alertText))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            @_alertText
        </MudAlert>
    }

    <MudDivider DividerType="DividerType.Middle" Class="my-6"/>

    <div class="d-flex flex-grow-1 gap-4 justify-center align-start">
        <MudTextField class="my-3" @bind-Value="_publicKey" Label="Public Key" Variant="Variant.Outlined" ReadOnly="true" Lines="10" AutoGrow="true"></MudTextField>
        <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_publicKey)" />
        </MudTooltip>
    </div>

    <div class="d-flex flex-grow-1 gap-4 justify-center align-start">
        <MudTextField class="my-3" @bind-Value="_privateKey" Label="Private Key" Variant="Variant.Outlined" ReadOnly="true" Lines="10" AutoGrow="true"></MudTextField>
        <MudTooltip ShowOnClick="false" ShowOnFocus="_showCopyToolTip" ShowOnHover="false" Text="Copied" >
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="copy" OnClick="() => CopyToClipboard(_privateKey)" />
        </MudTooltip>
    </div>
</MudPaper>

@code
{
    private string _alertText = string.Empty;
    private bool _showCopyToolTip;

    private IEnumerable<int> _keySize = new List<int> { 1024 };
    private const string XmlKey = "XML";
    private const string PemKey = "PEM";
    private IEnumerable<string> _keyOptions = new List<string> { XmlKey };
    private string _publicKey = string.Empty;
    private string _privateKey = string.Empty;

    private async void Encrypt()
    {
        try {
            var selectedKeySize = _keySize.FirstOrDefault();
            var selectedKeyFormat = _keyOptions.FirstOrDefault() == XmlKey ? XmlKey : PemKey;
            var response = await HttpClient.PostAsJsonAsync(
                Config.apiEndPoint + "/Encrypt/GenerateRSAKey", new EncryptKeyRequest()
                {
                    KeySize = selectedKeySize,
                    KeyFormat = selectedKeyFormat,
                });

            if (response.IsSuccessStatusCode)
            {
                var responseData = await response.Content.ReadFromJsonAsync<EncryptKeyResponse>();
                if (responseData != null)
                {
                    _publicKey = responseData.PublicKey;
                    _privateKey = responseData.PrivateKey;
                    _alertText = "";
                    _showCopyToolTip = true;
                    StateHasChanged();
                }
                else
                {
                    _publicKey = string.Empty;
                    _privateKey = string.Empty;
                    _alertText = "Error: No data received from server.";
                    _showCopyToolTip = true;
                    StateHasChanged();
                }
            }
            else
            {
                var errorMessage = await response.Content.ReadAsStringAsync();
                _alertText = "Error: " + errorMessage;
                _publicKey = string.Empty;
                _privateKey = string.Empty;
                _showCopyToolTip = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _showCopyToolTip = false;
            _publicKey = string.Empty;
            _privateKey = string.Empty;
            _alertText = "An unexpected error occurred: " + ex.Message;
            StateHasChanged();
        }
    }
    
    private async Task CopyToClipboard(string textToCopy)
    {
        if (textToCopy.Length > 0)
            await JS.InvokeVoidAsync("copyToClipboard", textToCopy);
    }
}